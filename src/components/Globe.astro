---
// 经纬网 + 陆地轮廓的线框地球（Canvas 正交投影）
// 数据：src/data/land.json（world-atlas land-110m，已解码量化）
// 交互：拖拽旋转 / 悬停暂停 / 自动缓慢自转 / 尊重 prefers-reduced-motion
const pin = { lon: 120.5853, lat: 31.2989, label: 'Suzhou' };
---

<figure class="globe" data-globe data-pin-lon={pin.lon} data-pin-lat={pin.lat}>
  <div class="globe__frame" data-cursor="Drag">
    <canvas class="globe__canvas" aria-hidden="true"></canvas>
  </div>
  <figcaption class="globe__cap">
    <span class="mono">Now at</span>
    <span class="mono globe__where">苏州 Suzhou</span>
    <span class="mono globe__coord">31.30° N / 120.59° E</span>
  </figcaption>
</figure>

<style>
  .globe {
    margin: 0;
    display: grid;
    gap: 14px;
    justify-items: center;
  }
  .globe__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    touch-action: pan-y;
    cursor: grab;
  }
  .globe__frame:active {
    cursor: grabbing;
  }
  .globe__canvas {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: block;
  }
  .globe__cap {
    display: grid;
    gap: 2px;
    justify-items: center;
    color: var(--gray);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .globe__where {
    color: var(--ink);
  }
  .globe__coord {
    color: var(--gray);
  }
</style>

<script>
  import land from '../data/land.json';

  const DEG = Math.PI / 180;
  const rings = (land as { rings: number[][][] }).rings;

  type Setup = { el: HTMLElement; run: () => void; stop: () => void };

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-globe]').forEach((el) => {
      if (el.dataset.ready === '1') return;
      el.dataset.ready = '1';
      start(el);
    });
  }

  function start(el: HTMLElement) {
    const canvas = el.querySelector<HTMLCanvasElement>('.globe__canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const pinLon = Number(el.dataset.pinLon ?? 120.6);
    const pinLat = Number(el.dataset.pinLat ?? 31.3);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const state = { lon0: pinLon + 8, lat0: 22, vel: 0, dragging: false, hover: false };
    let raf = 0;
    let lastView = 0;
    let w = 0;
    let h = 0;
    let r = 0;
    let last = performance.now();

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      w = Math.max(rect.width, 1);
      h = Math.max(rect.height, 1);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      r = Math.min(w, h) / 2 - 2;
    };

    // 正交投影：返回屏幕坐标与 z（>0 在前半球）
    const project = (lon: number, lat: number) => {
      const l = (lon - state.lon0) * DEG;
      const p = lat * DEG;
      const cosP = Math.cos(p);
      const x = cosP * Math.sin(l);
      const y = Math.sin(p);
      const z = cosP * Math.cos(l);
      const cl = Math.cos(state.lat0 * DEG);
      const sl = Math.sin(state.lat0 * DEG);
      const y2 = y * cl - z * sl;
      const z2 = y * sl + z * cl;
      return { x, y: y2, z: z2 };
    };

    const toScreen = (x: number, y: number) => ({
      sx: w / 2 + x * r,
      sy: h / 2 - y * r,
    });

    // 只描海岸线：正交投影下多边形填充会在球缘产生横切色带，
    // 线框反而更干净，也更贴合「仪器」的视觉语言
    const drawLand = () => {
      ctx.strokeStyle = 'rgba(88, 82, 72, 0.62)';
      ctx.lineWidth = 0.7;
      ctx.beginPath();
      for (const ring of rings) {
        let open = false;
        for (let i = 0; i < ring.length; i++) {
          const p = project(ring[i][0], ring[i][1]);
          if (p.z <= 0) {
            open = false;
            continue;
          }
          const { sx, sy } = toScreen(p.x, p.y);
          if (!open) {
            ctx.moveTo(sx, sy);
            open = true;
          } else {
            ctx.lineTo(sx, sy);
          }
        }
      }
      ctx.stroke();
    };

    const drawGraticule = () => {
      ctx.beginPath();
      // 纬线
      for (let lat = -60; lat <= 60; lat += 30) {
        let open = false;
        for (let lon = -180; lon <= 180; lon += 3) {
          const p = project(lon, lat);
          if (p.z <= 0) {
            open = false;
            continue;
          }
          const { sx, sy } = toScreen(p.x, p.y);
          if (!open) {
            ctx.moveTo(sx, sy);
            open = true;
          } else {
            ctx.lineTo(sx, sy);
          }
        }
      }
      // 经线
      for (let lon = -180; lon < 180; lon += 30) {
        let open = false;
        for (let lat = -90; lat <= 90; lat += 3) {
          const p = project(lon, lat);
          if (p.z <= 0) {
            open = false;
            continue;
          }
          const { sx, sy } = toScreen(p.x, p.y);
          if (!open) {
            ctx.moveTo(sx, sy);
            open = true;
          } else {
            ctx.lineTo(sx, sy);
          }
        }
      }
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.55)';
      ctx.lineWidth = 0.6;
      ctx.stroke();
    };

    const drawPin = (t: number) => {
      const p = project(pinLon, pinLat);
      if (p.z <= 0.02) return;
      const { sx, sy } = toScreen(p.x, p.y);
      const pulse = reduce ? 0 : (Math.sin(t / 620) + 1) / 2;
      ctx.beginPath();
      ctx.arc(sx, sy, 3.2, 0, Math.PI * 2);
      ctx.fillStyle = '#ff3b1f';
      ctx.fill();
      if (!reduce) {
        ctx.beginPath();
        ctx.arc(sx, sy, 3.2 + pulse * 9, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(255, 59, 31, ${0.55 * (1 - pulse)})`;
        ctx.lineWidth = 1;
        ctx.stroke();
      }
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);

      // 球体：浅色纸面
      const g = ctx.createRadialGradient(w * 0.34, h * 0.3, r * 0.1, w * 0.5, h * 0.5, r * 1.05);
      g.addColorStop(0, '#e0dbcf');
      g.addColorStop(0.62, '#c4beb0');
      g.addColorStop(1, '#9d9587');
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, r, 0, Math.PI * 2);
      ctx.fillStyle = g;
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, r, 0, Math.PI * 2);
      ctx.clip();

      drawLand();
      drawGraticule();

      // 边缘压暗，做出球感
      const shade = ctx.createRadialGradient(w * 0.42, h * 0.38, r * 0.55, w / 2, h / 2, r);
      shade.addColorStop(0, 'rgba(0,0,0,0)');
      shade.addColorStop(1, 'rgba(20, 18, 14, 0.22)');
      ctx.fillStyle = shade;
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, r, 0, Math.PI * 2);
      ctx.fill();

      drawPin(t);

      ctx.restore();

      // 球体外框
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, r, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(236, 233, 227, 0.22)';
      ctx.lineWidth = 1;
      ctx.stroke();
    };

    const tick = (t: number) => {
      const dt = Math.min(t - last, 64);
      last = t;

      if (!reduce) {
        if (state.dragging) {
          // 拖拽中不自动转
        } else if (Math.abs(state.vel) > 0.01) {
          state.lon0 -= state.vel * dt * 0.06;
          state.vel *= 0.94;
        } else if (!state.hover) {
          state.lon0 -= dt * 0.0045; // 约 4.5°/s
        }
      }

      if (state.lon0 > 180) state.lon0 -= 360;
      if (state.lon0 < -180) state.lon0 += 360;

      draw(t);

      // 把「视角中心」广播出去：首页那排读数会跟着变（仪器感的关键）
      if (t - lastView > 110) {
        lastView = t;
        window.dispatchEvent(
          new CustomEvent('globe:view', {
            detail: { lat: state.lat0, lon: state.lon0 },
          })
        );
      }

      raf = requestAnimationFrame(tick);
    };

    // 拖拽
    let lastX = 0;
    let lastY = 0;
    let vx = 0;
    const frame = el.querySelector<HTMLElement>('.globe__frame')!;

    frame.addEventListener('pointerenter', () => (state.hover = true));
    frame.addEventListener('pointerleave', () => (state.hover = false));
    frame.addEventListener('pointerdown', (e) => {
      state.dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      vx = 0;
      frame.setPointerCapture(e.pointerId);
    });
    frame.addEventListener('pointermove', (e) => {
      if (!state.dragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      lastX = e.clientX;
      lastY = e.clientY;
      state.lon0 -= dx * 0.3;
      state.lat0 = Math.max(-72, Math.min(72, state.lat0 - dy * 0.24));
      vx = dx;
    });
    const endDrag = (e: PointerEvent) => {
      if (!state.dragging) return;
      state.dragging = false;
      state.vel = vx;
      if (frame.hasPointerCapture(e.pointerId)) frame.releasePointerCapture(e.pointerId);
    };
    frame.addEventListener('pointerup', endDrag);
    frame.addEventListener('pointercancel', endDrag);

    const ro = new ResizeObserver(() => {
      resize();
      draw(performance.now());
    });
    ro.observe(canvas);
    resize();
    raf = requestAnimationFrame(tick);

    (el as HTMLElement & { __stop?: () => void }).__stop = () => cancelAnimationFrame(raf);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll<HTMLElement>('[data-globe]').forEach((el) => {
      (el as HTMLElement & { __stop?: () => void }).__stop?.();
      el.dataset.ready = '';
    });
  });
</script>
