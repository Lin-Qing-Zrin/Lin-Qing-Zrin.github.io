---
const links = [
  { href: '/work/', label: 'Work', cn: '作品' },
  { href: '/about/', label: 'About', cn: '关于' },
  { href: '/contact/', label: 'Contact', cn: '联系' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" data-cursor="hover">刘启征</a>
    <nav class="nav">
      {
        links.map((l) => (
          <a href={l.href} data-cursor="hover" aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
            <span class="nav__cn">{l.cn}</span>
          </a>
        ))
      }
    </nav>
  </div>
</header>
