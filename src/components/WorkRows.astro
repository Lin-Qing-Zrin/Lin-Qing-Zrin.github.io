---
const { items = [] } = Astro.props;
---

<div class="work-list">
  {
    items.map((work, i) => (
      <a
        class="work-row"
        href={`/work/${work.id}/`}
        data-preview={work.data.cover}
        data-ratio={work.data.ratio}
        data-reveal
        style={`--d:${i}`}
      >
        <span class="work-row__idx">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="work-row__title">{work.data.title}</h3>
        <span class="work-row__cat">{work.data.category}</span>
        <span class="work-row__year">{work.data.year}</span>
        <span class="work-row__thumb">
          <img src={work.data.cover} alt={work.data.title} loading="lazy" decoding="async" />
        </span>
      </a>
    ))
  }
</div>

<div class="preview" data-preview aria-hidden="true">
  <img class="preview__img is-front" alt="" decoding="async" />
  <img class="preview__img" alt="" decoding="async" />
</div>
