---
import Base from '../layouts/Base.astro';
import GhostWord from '../components/GhostWord.astro';
---

<Base
  title="Contact — 刘启征"
  description="Email is the best way to reach me — for collaborations, projects or a question about any work here."
>
  <section class="page-head wrap">
    <GhostWord text="Talk" />
    <h1 class="t-display">
      <span class="line-mask"><span style="--i:0">Let’s talk—</span></span>
    </h1>
    <p class="lede" data-reveal style="--d:1; margin-top:32px">
      Email is the best way to reach me — for collaborations, projects, or a question about anything here. I usually reply within a day.
      <span class="cn">合作、项目、或者对某个作品有疑问，直接发邮件最快，我基本一天内会回。</span>
    </p>
  </section>

  <section class="wrap" style="padding-bottom: clamp(80px, 12vw, 200px)">
    <a
      class="contact-mail"
      href="mailto:Linqingzhu0420@gmail.com"
      data-cursor="hover"
      data-reveal
    >
      Linqingzhu0420@gmail.com
    </a>

    <div class="footer-grid" style="margin-top: clamp(48px, 7vw, 96px)">
      <div>
        <h4>Douyin 抖音</h4>
        <ul>
          <li>
            <a
              class="link-u"
              href="https://www.douyin.com/search/39490590044"
              target="_blank"
              rel="noopener"
              data-cursor="hover">39490590044</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h4>Elsewhere</h4>
        <ul>
          <li>
            <a
              class="link-u"
              href="https://github.com/Lin-Qing-Zrin"
              target="_blank"
              rel="noopener"
              data-cursor="hover">GitHub — Lin-Qing-Zrin</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h4>Location</h4>
        <ul>
          <li>苏州 Suzhou, China</li>
          <li>Local time <span data-clock>—</span></li>
        </ul>
      </div>
    </div>
  </section>
</Base>
