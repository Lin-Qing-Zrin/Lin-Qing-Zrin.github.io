---
import Base from '../layouts/Base.astro';
---

<Base title="Contact — Your Name" description="Get in touch for collaborations, internships and commissioned work.">
  <section class="page-head wrap">
    <h1 class="t-display">
      <span class="line-mask"><span style="--i:0">Let’s talk—</span></span>
    </h1>
    <p class="lede" data-reveal style="--d:1; margin-top:32px">
      Best way to reach me is email. I usually reply within a day.
    </p>
  </section>

  <section class="wrap" style="padding-bottom: clamp(80px, 12vw, 200px)">
    <a
      class="contact-mail"
      href="mailto:hello@example.com"
      data-cursor="Write"
      data-reveal
    >
      hello@example.com
    </a>

    <div class="footer-grid" style="margin-top: clamp(48px, 7vw, 96px)">
      <div>
        <h4>Phone</h4>
        <ul>
          <li><a class="link-u" href="tel:+8613800000000" data-cursor="hover">+86 138 0000 0000</a></li>
        </ul>
      </div>
      <div>
        <h4>Socials</h4>
        <ul>
          <li><a class="link-u" href="https://www.douyin.com/" target="_blank" rel="noopener" data-cursor="hover">Douyin</a></li>
          <li><a class="link-u" href="https://space.bilibili.com/" target="_blank" rel="noopener" data-cursor="hover">Bilibili</a></li>
          <li><a class="link-u" href="https://github.com/" target="_blank" rel="noopener" data-cursor="hover">GitHub</a></li>
        </ul>
      </div>
      <div>
        <h4>Location</h4>
        <ul>
          <li>【城市】, China</li>
          <li>Local time <span data-clock>—</span></li>
        </ul>
      </div>
    </div>
  </section>
</Base>
