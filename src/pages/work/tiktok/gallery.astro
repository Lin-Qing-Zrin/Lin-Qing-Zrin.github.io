---
import Base from '../../../layouts/Base.astro';
import raw from '../../../data/tiktok.json';

type Item = {
  serie: string;
  serieSlug: string;
  title: string;
  src: string;
  w: number;
  h: number;
};

const src = raw as Item[];

// 把系列打散：按系列轮流取一张，避免同一系列扎堆
const bySerie = new Map<string, Item[]>();
for (const it of src) {
  if (!bySerie.has(it.serieSlug)) bySerie.set(it.serieSlug, []);
  bySerie.get(it.serieSlug)!.push(it);
}
const buckets = [...bySerie.values()];
const items: Item[] = [];
let guard = 0;
while (items.length < src.length && guard++ < 500) {
  for (const b of buckets) {
    const next = b.shift();
    if (next) items.push(next);
  }
}

const no = (n: number) => String(n).padStart(2, '0');
const ratio = (it: Item) => (it.w / it.h).toFixed(4);

// 固定的「散」：每个格子一点错位和大小差，看起来不是网格
const rand = (i: number) => {
  const x = Math.sin(i * 12.9898) * 43758.5453;
  return x - Math.floor(x);
};
const jitter = (i: number) => {
  const dy = Math.round((rand(i) * 2 - 1) * 62);
  const dx = Math.round((rand(i + 11) * 2 - 1) * 26);
  const sc = (0.72 + rand(i + 23) * 0.34).toFixed(3);
  return `--dy:${dy}px;--dx:${dx}px;--sc:${sc}`;
};
---

<Base
  title="TikTok — Gallery · 刘启征"
  description="47 条自发影像，铺成一张可以推拉的画布。"
  bare
>
  <div class="cvs" data-cvs>
    <div class="cvs__head mono">
      <a class="cvs__back" href="/work/tiktok/">← TikTok</a>
      <span class="cvs__meta">Gallery · {items.length} pieces</span>
      <span class="cvs__hint">滚动上下 · 移动跟随 · 按住拖拽 · 点开看大图</span>
    </div>

    <div class="cvs__track" data-track>
      {
        items.map((it, i) => (
          <button
            class="cvs__tile"
            type="button"
            data-i={i}
            style={`--r:${ratio(it)};${jitter(i)}`}
            aria-label={it.title}
          >
            <span class="cvs__label mono">
              <span>{it.serie.replace('系列', '')}</span>
              <span>{no(i + 1)}</span>
            </span>
            <span class="cvs__ph">
              <img src={it.src} alt={it.title} loading="lazy" decoding="async" draggable="false" />
            </span>
          </button>
        ))
      }
    </div>

    <div class="cvs__foot mono">
      <span>刘启征 · 抖音帐号</span>
      <span data-cvs-pos>0%</span>
    </div>
  </div>

  <div class="cvs-viewer" data-cv>
    <div class="cvs-viewer__bar mono">
      <span data-cv-count>—</span>
      <span data-cv-meta>—</span>
      <button class="cvs-viewer__close" type="button" data-cv-close>Close ✕</button>
    </div>
    <div class="cvs-viewer__stage">
      <img data-cv-img alt="" decoding="async" draggable="false" />
    </div>
    <div class="cvs-viewer__foot mono">
      <button class="cvs-viewer__nav" type="button" data-cv-prev>← Prev</button>
      <span data-cv-name>—</span>
      <button class="cvs-viewer__nav" type="button" data-cv-next>Next →</button>
    </div>
  </div>

  <script define:vars={{ items }}>
    function initCanvas() {
      const root = document.querySelector('[data-cvs]');
      const track = document.querySelector('[data-track]');
      const posEl = document.querySelector('[data-cvs-pos]');
      const vw = document.querySelector('[data-cv]');
      if (!root || !track || !vw) return;
      if (root.dataset.ready === '1') return;
      root.dataset.ready = '1';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // off = 已提交位移（滚轮/拖拽后保留）；drift = 指针跟随（松手回零）
      let offX = 0;
      let offY = 0;
      let driftX = 0;
      let driftY = 0;
      let scale = 1;
      let scaleT = 1;
      let x = 0;
      let y = 0;

      let down = false;
      let moved = 0;
      let fromX = 0;
      let fromY = 0;
      let offAtX = 0;
      let offAtY = 0;

      const maxY = () => Math.max(0, track.scrollHeight * scale - root.clientHeight);
      const maxX = () => Math.max(0, (track.scrollWidth * scale - root.clientWidth) / 2);
      const clampY = (v) => Math.max(-maxY(), Math.min(0, v));
      const clampX = (v) => Math.max(-maxX(), Math.min(maxX(), v));

      let prev = performance.now();
      const render = (now) => {
        const dt = Math.min(64, now - prev) / 16.67; // 以 60fps 为 1 帧基准
        prev = now;
        offX = clampX(offX);
        offY = clampY(offY);
        // 与刷新率无关的阻尼：144Hz 上不会「更快贴上去」
        const ease = (rate) => (reduce ? 1 : 1 - Math.pow(0.001, (dt * rate) / 10));
        const k = ease(down ? 1.6 : 0.8);
        x += (offX + driftX - x) * k;
        y += (offY + driftY - y) * k;
        scale += (scaleT - scale) * ease(0.9);
        track.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scale(${scale.toFixed(4)})`;
        if (posEl) {
          const total = Math.max(1, maxY());
          posEl.textContent = `${Math.round(Math.min(1, Math.max(0, -y / total)) * 100)}%`;
        }
        requestAnimationFrame(render);
      };
      requestAnimationFrame(render);

      root.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();
          offY = clampY(offY - e.deltaY * 0.9);
        },
        { passive: false }
      );

      root.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        down = true;
        moved = 0;
        fromX = e.clientX;
        fromY = e.clientY;
        offAtX = offX;
        offAtY = offY;
        scaleT = 0.955;
        root.classList.add('is-holding');
      });

      window.addEventListener('pointermove', (e) => {
        if (down) {
          const dx = e.clientX - fromX;
          const dy = e.clientY - fromY;
          moved = Math.max(moved, Math.abs(dx) + Math.abs(dy));
          offX = clampX(offAtX + dx * 0.9);
          offY = clampY(offAtY + dy * 0.9);
          driftX = 0;
          driftY = 0;
          return;
        }
        // 360°：上下左右都跟着指针走
        const nx = e.clientX / window.innerWidth - 0.5;
        const ny = e.clientY / window.innerHeight - 0.5;
        driftX = -nx * 2 * 56;
        driftY = -ny * 2 * 46;
      });

      const release = () => {
        if (!down) return;
        down = false;
        scaleT = 1;
        root.classList.remove('is-holding');
      };
      window.addEventListener('pointerup', release);
      window.addEventListener('pointercancel', release);
      window.addEventListener('blur', release);

      // ---- 点开大图 ----
      const vImg = vw.querySelector('[data-cv-img]');
      const vName = vw.querySelector('[data-cv-name]');
      const vMeta = vw.querySelector('[data-cv-meta]');
      const vCount = vw.querySelector('[data-cv-count]');
      let cur = 0;

      const openAt = (i) => {
        cur = (i + items.length) % items.length;
        const it = items[cur];
        vImg.src = it.src;
        vImg.alt = it.title;
        vName.textContent = it.title;
        vMeta.textContent = `${it.serie.replace('系列', '')} · ${it.w}×${it.h}`;
        vCount.textContent = `${cur + 1} / ${items.length}`;
        vw.classList.add('is-on');
        document.documentElement.classList.add('is-locked');
      };
      const closeViewer = () => {
        vw.classList.remove('is-on');
        document.documentElement.classList.remove('is-locked');
      };

      root.addEventListener('click', (e) => {
        if (moved > 6) {
          moved = 0; // 拖过一次，这一次不算点击
          return;
        }
        const hit = document.elementFromPoint(e.clientX, e.clientY);
        const tile = e.target.closest?.('.cvs__tile') || hit?.closest('.cvs__tile');
        if (!tile) return;
        openAt(Number(tile.dataset.i));
      });

      vw.addEventListener('click', (e) => {
        const t = e.target;
        if (t.closest('[data-cv-prev]')) return openAt(cur - 1);
        if (t.closest('[data-cv-next]')) return openAt(cur + 1);
        if (t.closest('[data-cv-close]') || t === vw) closeViewer();
      });

      if (!window.__cvsKeys) {
        window.__cvsKeys = true;
        window.addEventListener('keydown', (e) => {
          if (!vw.classList.contains('is-on')) return;
          if (e.key === 'Escape') closeViewer();
          if (e.key === 'ArrowLeft') openAt(cur - 1);
          if (e.key === 'ArrowRight') openAt(cur + 1);
        });
      }
    }

    document.addEventListener('astro:page-load', initCanvas);
    initCanvas();
  </script>
</Base>
