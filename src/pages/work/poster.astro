---
import Base from '../../layouts/Base.astro';

const posters = [
  { n: '01', t: '渡口', g: '参赛作品', src: '/images/poster/p01.webp', w: 1400, h: 1980 },
  { n: '02', t: '幕影', g: '参赛作品', src: '/images/poster/p02.webp', w: 1400, h: 1980 },
  { n: '03', t: '山河赤旗', g: '参赛作品', src: '/images/poster/p03.webp', w: 1400, h: 1934 },
  { n: '04', t: '香水产品设计', g: '参赛作品', src: '/images/poster/p04.webp', w: 1400, h: 2489 },
  { n: '05', t: '影戏', g: '参赛作品', src: '/images/poster/p05.webp', w: 1400, h: 788 },
  { n: '06', t: '赠虫', g: '参赛作品', src: '/images/poster/p06.webp', w: 1400, h: 1980 },
  { n: '07', t: '不偏书签 · 产品', g: '文创设计', src: '/images/poster/p07.webp', w: 1400, h: 1980 },
  { n: '08', t: '不偏书签 · 结构', g: '文创设计', src: '/images/poster/p08.webp', w: 1400, h: 1980 },
  { n: '09', t: '定风波', g: '水墨古诗', src: '/images/poster/p09.webp', w: 1400, h: 1867 },
  { n: '10', t: '琵琶行', g: '水墨古诗', src: '/images/poster/p10.webp', w: 1400, h: 1867 },
  { n: '11', t: '美育日记 · 03.04', g: '美育日记', src: '/images/poster/p11.webp', w: 1400, h: 1980 },
  { n: '12', t: '美育日记 · 03.05', g: '美育日记', src: '/images/poster/p12.webp', w: 1400, h: 2100 },
  { n: '13', t: '美育日记 · 04.12', g: '美育日记', src: '/images/poster/p13.webp', w: 1400, h: 1983 },
  { n: '14', t: '美育日记 · 05.14', g: '美育日记', src: '/images/poster/p14.webp', w: 1400, h: 2100 },
  { n: '15', t: '美育日记 · 05.20', g: '美育日记', src: '/images/poster/p15.webp', w: 1400, h: 2100 },
  { n: '16', t: '美育日记 · 07.15', g: '美育日记', src: '/images/poster/p16.webp', w: 1400, h: 1960 },
  { n: '17', t: '美育日记 · 11.14', g: '美育日记', src: '/images/poster/p17.webp', w: 1400, h: 2100 },
  { n: '18', t: '美育日记 · 11.15', g: '美育日记', src: '/images/poster/p18.webp', w: 1400, h: 2100 },
];

const groups = ['参赛作品', '文创设计', '水墨古诗', '美育日记'];
---

<Base
  title="Poster — 刘启征"
  description="Poster archive: competition entries, cultural merchandise, ink-wash poetry and a daily art-education diary."
>
  <section class="ps" data-ps>
    <header class="ps-head mono">
      <a href="/work/">← WORK</a>
      <span>07 / 07 · POSTER · 海报</span>
      <span>{posters.length} SHEETS</span>
    </header>

    <div class="ps-intro">
      <h1 class="ps-title">Sheets</h1>
      <p class="ps-sub">
        18 张印刷稿，四组：参赛、文创、水墨古诗、美育日记。按工作台顺序排，不挑最好看的。
      </p>
      <p class="mono ps-hint">点击任意一张放大 · ← → 翻页 · Esc 关闭</p>
    </div>

    {groups.map((g) => (
      <section class="ps-group">
        <div class="ps-group__head mono">
          <span>{g}</span>
          <span>{posters.filter((p) => p.g === g).length}</span>
        </div>
        <div class="ps-grid">
          {posters
            .filter((p) => p.g === g)
            .map((p) => {
              const idx = posters.findIndex((x) => x.n === p.n);
              return (
                <button
                  class="ps-tile"
                  type="button"
                  data-open={idx}
                  aria-label={`放大 ${p.t}`}
                >
                  <span class="ps-tile__img">
                    <img src={p.src} alt={p.t} loading="lazy" width={p.w} height={p.h} />
                  </span>
                  <span class="ps-tile__cap mono">
                    <span>{p.n}</span>
                    <span class="ps-tile__t">{p.t}</span>
                    <span class="ps-tile__r">
                      {p.w}×{p.h}
                    </span>
                  </span>
                </button>
              );
            })}
        </div>
      </section>
    ))}

    <footer class="ps-foot mono">
      <span>ILLUSTRATOR · PHOTOSHOP · 印刷 300dpi</span>
      <a href="/work/">ALL CATEGORIES →</a>
    </footer>
  </section>

  <div class="lb" data-lb aria-hidden="true">
    <div class="lb__bar mono">
      <span data-lb-count>1 / 18</span>
      <span data-lb-title></span>
      <button class="lb__close mono" type="button" data-lb-close>CLOSE ✕</button>
    </div>
    <figure class="lb__stage">
      <img data-lb-img alt="" />
    </figure>
    <div class="lb__foot mono">
      <button type="button" data-lb-prev>← PREV</button>
      <span data-lb-dims></span>
      <button type="button" data-lb-next>NEXT →</button>
    </div>
  </div>

  <script define:vars={{ posters }}>
    const lb = document.querySelector('[data-lb]');
    const img = lb.querySelector('[data-lb-img]');
    const count = lb.querySelector('[data-lb-count]');
    const title = lb.querySelector('[data-lb-title]');
    const dims = lb.querySelector('[data-lb-dims]');
    let at = 0;

    const paint = () => {
      const p = posters[at];
      img.src = p.src;
      img.alt = p.t;
      count.textContent = `${String(at + 1).padStart(2, '0')} / ${posters.length}`;
      title.textContent = p.t;
      dims.textContent = `${p.w}×${p.h}`;
    };
    const open = (i) => {
      at = i;
      paint();
      lb.classList.add('is-on');
      lb.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('is-locked');
    };
    const close = () => {
      lb.classList.remove('is-on');
      lb.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('is-locked');
    };
    const go = (d) => {
      at = (at + d + posters.length) % posters.length;
      paint();
    };

    document.querySelectorAll('[data-open]').forEach((b) => {
      b.addEventListener('click', () => open(Number(b.dataset.open)));
    });
    lb.querySelector('[data-lb-close]').addEventListener('click', close);
    lb.querySelector('[data-lb-prev]').addEventListener('click', () => go(-1));
    lb.querySelector('[data-lb-next]').addEventListener('click', () => go(1));
    window.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('is-on')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    });
  </script>
</Base>

<style>
  .ps {
    padding: 0 var(--pad) clamp(48px, 7vw, 96px);
  }

  .ps-head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 84px 0 22px;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--gray);
    border-bottom: 1px solid var(--line);
  }
  .ps-head a {
    color: var(--ink);
    text-decoration: none;
  }
  .ps-head a:hover {
    color: var(--accent);
  }

  .ps-intro {
    padding: clamp(32px, 4.4vw, 60px) 0 clamp(22px, 3vw, 40px);
  }
  .ps-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 128px);
    line-height: 0.9;
    letter-spacing: -0.035em;
    margin: 0 0 14px;
  }
  .ps-sub {
    max-width: 46ch;
    font-size: 15px;
    line-height: 1.9;
    color: var(--ink-2);
  }
  .ps-hint {
    margin-top: 16px;
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--gray);
  }

  .ps-group {
    margin-top: clamp(26px, 3.4vw, 48px);
  }
  .ps-group__head {
    display: flex;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--gray);
  }

  .ps-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 20px);
    padding-top: clamp(14px, 1.8vw, 24px);
  }

  .ps-tile {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: zoom-in;
    z-index: 1;
    transition: transform 0.5s var(--ease), z-index 0s;
  }
  .ps-tile__img {
    display: block;
    overflow: hidden;
    background: #141311;
    aspect-ratio: 3 / 4;
  }
  .ps-tile__img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: saturate(0.9) brightness(0.92);
    transition: filter 0.45s var(--ease), transform 0.7s var(--ease);
  }
  .ps-tile__cap {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 8px;
    align-items: baseline;
    padding-top: 8px;
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--gray);
  }
  .ps-tile__t {
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ps-tile__r {
    opacity: 0.55;
  }

  @media (hover: hover) {
    .ps-tile:hover {
      transform: scale(1.055);
      z-index: 3;
    }
    .ps-tile:hover .ps-tile__img img {
      filter: none;
    }
    .ps-tile:hover .ps-tile__cap {
      color: var(--accent);
    }
    .ps-tile:hover .ps-tile__t {
      color: var(--ink);
    }
    .ps-grid:hover .ps-tile:not(:hover) {
      opacity: 0.66;
    }
  }

  .ps-foot {
    display: flex;
    justify-content: space-between;
    margin-top: clamp(34px, 4.4vw, 60px);
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--gray);
  }
  .ps-foot a {
    color: var(--ink);
    text-decoration: none;
  }
  .ps-foot a:hover {
    color: var(--accent);
  }

  .lb {
    position: fixed;
    inset: 0;
    z-index: 240;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    background: #080807;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease);
  }
  .lb.is-on {
    opacity: 1;
    pointer-events: auto;
  }
  .lb__bar,
  .lb__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    padding: 18px var(--pad);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--gray);
  }
  .lb__bar {
    border-bottom: 1px solid var(--line);
  }
  .lb__foot {
    border-top: 1px solid var(--line);
  }
  .lb__close,
  .lb__foot button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    letter-spacing: inherit;
    color: var(--ink);
    cursor: pointer;
  }
  .lb__close:hover,
  .lb__foot button:hover {
    color: var(--accent);
  }
  .lb__stage {
    position: relative;
    margin: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    min-height: 0;
    padding: clamp(12px, 3vw, 40px);
  }
  .lb__stage img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  @media (max-width: 1100px) {
    .ps-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .ps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ps-head > span:last-child {
    margin-right: 104px;
  }
</style>
