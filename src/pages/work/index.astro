---
import Base from '../../layouts/Base.astro';
import WorkRows from '../../components/WorkRows.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work — Your Name" description="Selected work: posters, short films and AI visual experiments.">
  <section class="page-head wrap">
    <h1 class="t-display">
      <span class="line-mask"><span style="--i:0">Work</span></span>
    </h1>
    <p class="t-meta" data-reveal style="--d:1">{works.length} selected projects · 2023–2024</p>
  </section>

  <section class="wrap" style="padding-bottom: clamp(64px, 10vw, 160px)">
    <WorkRows items={works} />
  </section>
</Base>
