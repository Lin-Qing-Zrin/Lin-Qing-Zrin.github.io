---
import Base from '../../layouts/Base.astro';
import GhostWord from '../../components/GhostWord.astro';
import raw from '../../data/tiktok.json';

type Item = {
  serie: string;
  serieSlug: string;
  title: string;
  src: string;
  w: number;
  h: number;
  note?: string;
};

const items = raw as Item[];
const series: { slug: string; name: string; count: number }[] = [];
for (const it of items) {
  const hit = series.find((s) => s.slug === it.serieSlug);
  if (hit) hit.count += 1;
  else series.push({ slug: it.serieSlug, name: it.serie, count: 1 });
}
const no = (n: number) => String(n).padStart(2, '0');
const total = items.length;
const ratio = (it: Item) => (it.w / it.h).toFixed(4);
---

<Base
  title="TikTok 抖音帐号 — 刘启征"
  description="47 条自发影像，分七个系列：古韵江南、地球脉动、治愈风景、建筑教学、MC·光遇、二次元、红色。"
>
  <section class="page-head wrap">
    <GhostWord text="TikTok" />
    <div class="case-bar mono" data-reveal>
      <span>01 / 07</span>
      <span>Self-media · 抖音帐号</span>
      <span>{total} pieces</span>
    </div>
    <h1 class="tk-h1">
      <span class="line-mask"><span style="--i:0">TikTok</span></span>
    </h1>
    <p class="t-meta" data-reveal style="--d:1">抖音帐号 · {series.length} 个系列 · {total} 条</p>
    <p class="cn" data-reveal style="--d:2">
      一个人跑完选题、出图、剪辑和发布。平铺看图，鼠标左右移动可以推拉，滚轮缩放，点开看大图和说明。
    </p>
  </section>

  <section class="wrap" style="padding-bottom: clamp(64px, 10vw, 160px)">
    <div class="toolbar" data-reveal>
      <div class="chips" data-chips>
        <button class="chip is-active" data-chip="all" type="button">
          All <span class="chip__n">{total}</span>
        </button>
        {
          series.map((s) => (
            <button class="chip" data-chip={s.slug} type="button">
              {s.name.replace('系列', '')} <span class="chip__n">{s.count}</span>
            </button>
          ))
        }
      </div>
      <div class="viewbar mono">
        <button class="vbtn is-active" data-view="grid" type="button">Grid 平铺</button>
        <button class="vbtn" data-view="list" type="button">List 列表</button>
      </div>
    </div>

    <section class="gal" data-gal>
      <div class="gal__track" data-gal-track>
        {
          items.map((it, i) => (
            <button
              class="gal__tile"
              type="button"
              data-i={i}
              data-serie={it.serieSlug}
              style={`--r:${ratio(it)}`}
              aria-label={it.title}
            >
              <img src={it.src} alt={it.title} loading="lazy" decoding="async" />
              <span class="gal__cap">{it.title}</span>
            </button>
          ))
        }
      </div>
    </section>

    <div class="tk-list is-off" data-tk-list>
      {
        items.map((it, i) => (
          <button
            class="tk-row"
            type="button"
            data-i={i}
            data-serie={it.serieSlug}
            style={`--r:${ratio(it)}`}
          >
            <span class="tk-row__idx">{no(i + 1)}</span>
            <span class="tk-row__thumb">
              <img src={it.src} alt={it.title} loading="lazy" decoding="async" />
            </span>
            <span class="tk-row__title">{it.title}</span>
            <span class="tk-row__serie">{it.serie.replace('系列', '')}</span>
            <span class="tk-row__dim">
              {it.w}×{it.h}
            </span>
          </button>
        ))
      }
    </div>
  </section>

  <div class="viewer" data-viewer>
    <div class="viewer__bar mono">
      <span data-viewer-count>—</span>
      <span data-viewer-meta>—</span>
      <button class="viewer__close" type="button" data-viewer-close>Close ✕</button>
    </div>
    <figure class="viewer__stage">
      <div class="viewer__frame">
        <img data-viewer-img alt="" decoding="async" />
        <figcaption class="viewer__note mono" data-viewer-note>—</figcaption>
      </div>
    </figure>
    <div class="viewer__foot mono">
      <button class="viewer__nav" type="button" data-viewer-prev>← Prev</button>
      <span data-viewer-name class="viewer__name">—</span>
      <button class="viewer__nav" type="button" data-viewer-next>Next →</button>
    </div>
  </div>

  <script define:vars={{ items }}>
    function initTiktok() {
      const gal = document.querySelector('[data-gal]');
      const track = document.querySelector('[data-gal-track]');
      const list = document.querySelector('[data-tk-list]');
      const viewer = document.querySelector('[data-viewer]');
      const vImg = document.querySelector('[data-viewer-img]');
      const vName = document.querySelector('[data-viewer-name]');
      const vMeta = document.querySelector('[data-viewer-meta]');
      const vNote = document.querySelector('[data-viewer-note]');
      const vCount = document.querySelector('[data-viewer-count]');
      if (!gal || !track || !list || !viewer) return;

      const tiles = Array.from(track.querySelectorAll('.gal__tile'));
      const rows = Array.from(list.querySelectorAll('.tk-row'));
      const chips = Array.from(document.querySelectorAll('[data-chip]'));
      const vbtns = Array.from(document.querySelectorAll('[data-view]'));

      let filter = 'all';
      let pool = items.map((_, i) => i);
      let cursor = 0;

      const matches = (i) => filter === 'all' || items[i].serieSlug === filter;

      const applyFilter = () => {
        pool = items.map((_, i) => i).filter(matches);
        for (const el of [...tiles, ...rows]) {
          const i = Number(el.dataset.i);
          el.classList.toggle('is-hidden', !matches(i));
        }
      };

      const cap = (it) => `${it.serie.replace('系列', '')} · ${it.w}×${it.h}`;

      const open = (pos) => {
        if (!pool.length) return;
        cursor = (pos + pool.length) % pool.length;
        const it = items[pool[cursor]];
        vImg.src = it.src;
        vImg.alt = it.title;
        if (vName) vName.textContent = it.title;
        if (vMeta) vMeta.textContent = cap(it);
        if (vNote) vNote.textContent = it.note || `${it.serie.replace('系列', '')} · 第 ${cursor + 1} / ${pool.length} 张`;
        if (vCount) vCount.textContent = `${cursor + 1} / ${pool.length}`;
        viewer.classList.add('is-on');
        document.documentElement.classList.add('is-locked');
      };

      const close = () => {
        viewer.classList.remove('is-on');
        document.documentElement.classList.remove('is-locked');
      };

      chips.forEach((chip) => {
        if (chip.dataset.b) return;
        chip.dataset.b = '1';
        chip.addEventListener('click', () => {
          filter = chip.dataset.chip;
          chips.forEach((c) => c.classList.toggle('is-active', c === chip));
          applyFilter();
        });
      });

      vbtns.forEach((b) => {
        if (b.dataset.b) return;
        b.dataset.b = '1';
        b.addEventListener('click', () => {
          const mode = b.dataset.view;
          vbtns.forEach((x) => x.classList.toggle('is-active', x === b));
          gal.classList.toggle('is-off', mode !== 'grid');
          list.classList.toggle('is-off', mode !== 'list');
        });
      });

      const onClick = (e) => {
        const hit = e.target.closest('[data-i]');
        if (!hit) return;
        const i = Number(hit.dataset.i);
        const pos = pool.indexOf(i);
        if (pos >= 0) open(pos);
      };
      if (!track.dataset.b) {
        track.dataset.b = '1';
        track.addEventListener('click', onClick);
      }
      if (!list.dataset.b) {
        list.dataset.b = '1';
        list.addEventListener('click', onClick);
      }

      if (!viewer.dataset.b) {
        viewer.dataset.b = '1';
        viewer.addEventListener('click', (e) => {
          const t = e.target;
          if (t.closest('[data-viewer-prev]')) return open(cursor - 1);
          if (t.closest('[data-viewer-next]')) return open(cursor + 1);
          if (t.closest('[data-viewer-close]') || t === viewer) close();
        });
      }

      // 平铺：指针左右推拉 + 滚轮缩放
      if (!gal.dataset.p) {
        gal.dataset.p = '1';
        let z = 1;
        let zt = 1;
        let x = 0;
        let xt = 0;
        let dragging = false;
        let dragFrom = 0;

        const maxPan = () => {
          const over = track.scrollWidth * z - gal.clientWidth;
          return Math.max(0, over / 2);
        };
        const clampX = (v) => {
          const m = maxPan();
          return Math.max(-m, Math.min(m, v));
        };

        const loop = () => {
          z += (zt - z) * 0.12;
          x += (xt - x) * 0.12;
          track.style.transform = `translate3d(${x.toFixed(2)}px, 0, 0) scale(${z.toFixed(4)})`;
          requestAnimationFrame(loop);
        };

        gal.addEventListener(
          'wheel',
          (e) => {
            if (gal.classList.contains('is-off')) return;
            e.preventDefault();
            zt = Math.max(0.6, Math.min(2.4, zt * (1 - e.deltaY * 0.0012)));
            xt = clampX(xt);
          },
          { passive: false }
        );

        gal.addEventListener('pointermove', (e) => {
          if (gal.classList.contains('is-off')) return;
          if (dragging) {
            xt = clampX(xt + (e.clientX - dragFrom) * 1.1);
            dragFrom = e.clientX;
            return;
          }
          const k = (e.clientX / window.innerWidth - 0.5) * 2;
          xt = clampX(-k * maxPan() * 0.55);
        });

        gal.addEventListener('pointerdown', (e) => {
          if (gal.classList.contains('is-off')) return;
          dragging = true;
          dragFrom = e.clientX;
        });
        gal.addEventListener('pointerup', () => {
          dragging = false;
        });
        gal.addEventListener('pointercancel', () => {
          dragging = false;
        });

        loop();
      }

      if (!window.__tkKeys) {
        window.__tkKeys = true;
        window.addEventListener('keydown', (e) => {
          if (!viewer.classList.contains('is-on')) return;
          if (e.key === 'Escape') close();
          if (e.key === 'ArrowLeft') open(cursor - 1);
          if (e.key === 'ArrowRight') open(cursor + 1);
        });
      }
    }

    document.addEventListener('astro:page-load', initTiktok);
    initTiktok();
  </script>
</Base>
