---
import Base from '../layouts/Base.astro';

const items = [
  { id: 'console', title: '控制台', hint: '你从来没按下过 F12。' },
  { id: 'raw', title: '毛片模式', hint: '四个字母，是我名字前面那一半。' },
  { id: 'pin', title: '苏州那一盏', hint: '节气盘上那盏小灯不是装饰。' },
  { id: 'note', title: '跑太快的那行字', hint: '页脚的字跑得很快，按一下它就停。' },
  { id: 'tc', title: '定格', hint: '时间码一直在走，但它可以停。' },
];
---

<Base
  title="Secrets — Tupo_小满"
  description="五个不在导航里的东西。找不到也不影响看作品。"
>
  <section class="wrap page-head">
    <span class="mono">FIND THE LAYER · 不在导航里的东西</span>
    <h1 class="t-h1">Secrets</h1>
    <p class="lede">
      Five things I hid. None of them are needed to read the work — they are for whoever stays
      a little longer.
    </p>
    <p class="cn">
      五个藏起来的小东西，找到不会多给你什么，找不到也不影响看作品。下面每行只给一句提示，不给答案。
    </p>
  </section>

  <section class="wrap sec-list" data-sec-list>
    {
      items.map((it, i) => (
        <div class="sec-row" data-sec={it.id}>
          <span class="sec-row__idx mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="sec-row__title">{it.title}</span>
          <span class="sec-row__hint mono">{it.hint}</span>
          <span class="sec-row__state mono" data-sec-state>
            ○
          </span>
        </div>
      ))
    }
  </section>

  <section class="wrap sec-final" data-sec-final>
    <p class="mono">ALL FIVE · 全找到了</p>
    <p class="lede">
      You found all five. One honest line in return: this site is one person, including the dial —
      every piece of land on it is a few thousand points computed in the browser.
    </p>
    <p class="cn">
      五个都找到了。作为交换，说一句实话：这站是我一个人写的，包括中间那个节气盘——二十四个节气的位置，都是当场算出来的。
    </p>
  </section>

  <section class="wrap sec-reset">
    <button class="btn mono" type="button" data-sec-reset>RESET · 清空记录</button>
  </section>
</Base>

<script>
  /* 彩蛋清单：从 localStorage 读已找到的条目，找到就点亮 */
  const KEY = 'tupo.found';
  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? '[]') as string[];
    } catch {
      return [];
    }
  };

  const paint = () => {
    const found = read();
    const rows = document.querySelectorAll<HTMLElement>('[data-sec]');
    let hits = 0;
    rows.forEach((row) => {
      const id = row.dataset.sec ?? '';
      const state = row.querySelector<HTMLElement>('[data-sec-state]');
      const on = found.includes(id);
      row.classList.toggle('is-found', on);
      if (state) state.textContent = on ? '●' : '○';
      if (on) hits += 1;
    });
    const final = document.querySelector<HTMLElement>('[data-sec-final]');
    final?.classList.toggle('is-on', hits === rows.length && rows.length > 0);
  };

  paint();
  document.addEventListener('astro:page-load', paint);
  document.addEventListener('ds:found', paint);
  document.querySelector('[data-sec-reset]')?.addEventListener('click', () => {
    localStorage.removeItem(KEY);
    paint();
  });
</script>
