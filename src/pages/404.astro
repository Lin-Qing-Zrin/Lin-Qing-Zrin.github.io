---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Tupo_小满" description="Page not found.">
  <section class="page-head wrap" style="min-height:70svh; display:flex; flex-direction:column; justify-content:center">
    <p class="mono" data-reveal>Error 404 · 错误 404</p>
    <h1 class="t-display" style="margin-top:16px">
      <span class="line-mask"><span style="--i:0">Nothing here—</span></span>
    </h1>
    <p class="lede" data-reveal style="--d:1; margin-top:28px">
      The page you're looking for doesn't exist, or it moved somewhere quieter.
      <span class="cn">你要找的页面不存在，或者它搬到别处去了。</span>
    </p>
    <p style="margin-top:32px" data-reveal>
      <a class="btn" href="/" data-cursor="hover">Back home 回首页</a>
    </p>
  </section>
</Base>
