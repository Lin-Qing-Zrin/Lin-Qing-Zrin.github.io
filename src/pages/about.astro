---
import Base from '../layouts/Base.astro';
import GhostWord from '../components/GhostWord.astro';

type Tool = { label: string; logo?: string; mark?: string; bg?: string; fg?: string; invert?: boolean };

// 制作工具：真实品牌 svg 放在 public/logos/
const stack: Tool[] = [
  { label: 'Unreal Engine 5', logo: '/logos/ue5.svg', invert: true },
  { label: 'Blender', logo: '/logos/blender.svg' },
  { label: 'Premiere Pro', logo: '/logos/premiere.svg', invert: true },
  { label: 'After Effects', logo: '/logos/aftereffects.svg', invert: true },
  { label: 'Photoshop', logo: '/logos/photoshop.svg', invert: true },
  { label: 'Figma', logo: '/logos/figma.svg' },
  { label: 'ComfyUI', logo: '/logos/comfyui.svg' },
  { label: 'Cursor · Vibe coding', logo: '/logos/cursor.svg', invert: true },
];

// AI：日常一起干活的那几个
const ai: Tool[] = [
  { label: 'DeepSeek', logo: '/logos/deepseek.svg' },
  { label: 'ChatGPT', logo: '/logos/chatgpt.svg', invert: true },
  { label: 'Claude', logo: '/logos/claude.svg' },
  { label: 'Gemini', logo: '/logos/gemini.svg' },
  { label: 'Grok', logo: '/logos/grok.svg' },
  { label: 'GrokBot', logo: '/logos/grok.svg' },
  { label: 'Antigravity', logo: '/logos/antigravity.svg' },
];
---

<Base
  title="About — 刘启征"
  description="Digital Media Technology student in Suzhou — video work, game levels, VFX, and the account that publishes them."
>
  <section class="page-head wrap">
    <GhostWord text="About" />
    <h1 class="t-display">
      <span class="line-mask"><span style="--i:0">About—</span></span>
    </h1>
  </section>

  <section class="wrap about-grid">
    <div class="prose" data-reveal>
      <p class="lede">
        I'm 刘启征 (Lin), a Digital Media Technology student in Suzhou. I make video work,
        build Wuxia levels in Unreal Engine 5, and do 3D and VFX in Blender.
      </p>
      <p class="cn">
        我是刘启征，数字媒体技术专业在读。做视频创作、在虚幻 5 里搭武侠场景、用 Blender
        做三维和特效。
      </p>

      <p>
        Most things I want to see don't exist yet, so I build them: block the shot in
        engine, light it, cut it against the music, then publish it and watch what happens.
        When the tool I need is missing, I code it — small scripts, web toys, whatever
        closes the gap. That's the vibe-coding part, and it's usually faster than waiting
        for a plugin.
      </p>
      <p class="cn">
        我想看的东西大多还不存在，所以自己做：在引擎里摆机位、布光、卡着音乐剪，发出去看
        反应。缺工具就自己写——小脚本、网页小玩具，能补上那个缺口就行。所谓 vibe coding
        就是这么回事，通常比等插件快。
      </p>

      <p>
        Still in progress: one Wuxia level, a video account that ships weekly, and a folder
        of shaders that don't compile yet. The list keeps getting longer, which is the
        point.
      </p>
      <p class="cn">
        还在做的：一关武侠关卡、一个每周更新的视频账号、一堆还没编译通过的着色器。
        清单只会越来越长——这本来就是要的样子。
      </p>

      <h3>What I work with</h3>
    </div>

    <aside class="about-aside" data-reveal style="--d:1">
      <div>
        <h4>Based in</h4>
        <p>苏州 Suzhou, China</p>
      </div>
      <div>
        <h4>Studying</h4>
        <p>Digital Media Technology</p>
      </div>
      <div>
        <h4>Direction</h4>
        <p>Video · Game engine · VFX · Self-media</p>
      </div>
      <div>
        <h4>Contact</h4>
        <p>
          <a class="link-u" href="mailto:Linqingzhu0420@gmail.com" data-cursor="hover"
            >Linqingzhu0420@gmail.com</a
          >
        </p>
      </div>
    </aside>
  </section>

  <section class="wrap about-tools" data-reveal>
    <p class="mono tool-cap">STACK <span class="cn cn--inline">制作</span></p>
    <ul class="tool-grid">
      {stack.map((t) => (
        <li class="tool">
          {t.logo ? (
            <img class:list={['tool__logo', t.invert && 'is-invert']} src={t.logo} alt={t.label} />
          ) : (
            <span class="tool__mark" aria-hidden="true">{t.mark}</span>
          )}
          <span class="tool__label">{t.label}</span>
        </li>
      ))}
    </ul>

    <p class="mono tool-cap" style="margin-top: clamp(34px, 4vw, 62px)">
      AI <span class="cn cn--inline">一起干活的</span>
    </p>
    <ul class="tool-grid">
      {ai.map((t) => (
        <li class="tool">
          {t.logo ? (
            <img class:list={['tool__logo', t.invert && 'is-invert']} src={t.logo} alt={t.label} />
          ) : (
            <span class="tool__mark" aria-hidden="true">{t.mark}</span>
          )}
          <span class="tool__label">{t.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap about-now">
    <div class="split">
      <p class="mono">NOW 现在</p>
      <p class="t-h3">
        Building one pipeline from first sketch to release, and writing down what breaks
        along the way.
      </p>
    </div>
  </section>
</Base>

<style>
  .about-tools {
    padding-block: clamp(6px, 1.2vw, 18px) clamp(56px, 8vw, 110px);
  }
  .tool-cap {
    color: var(--gray);
    margin-bottom: clamp(14px, 1.6vw, 22px);
  }
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.8vw, 26px);
    list-style: none;
    max-width: 1100px;
  }
  .tool {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 16px;
    min-height: clamp(128px, 13vw, 168px);
    padding: 20px 12px 18px;
    outline: 1px solid var(--line);
    transition:
      outline-color 0.35s var(--ease),
      transform 0.35s var(--ease),
      background 0.35s var(--ease);
  }
  .tool:hover {
    outline-color: var(--accent);
    transform: translateY(-3px);
    background: rgba(236, 233, 227, 0.02);
  }
  .tool__logo {
    width: clamp(44px, 3.6vw, 62px);
    height: clamp(44px, 3.6vw, 62px);
    object-fit: contain;
  }
  .tool__logo.is-invert {
    filter: invert(1) brightness(1.15);
  }
  .tool__mark {
    width: clamp(44px, 3.6vw, 62px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: clamp(17px, 1.5vw, 22px);
    background: #161614;
    color: var(--ink);
    border-radius: 14px;
  }
  .tool__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--gray);
    text-align: center;
    line-height: 1.35;
  }
  .about-now {
    padding-bottom: clamp(80px, 12vw, 180px);
  }
  @media (max-width: 780px) {
    .tool-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
