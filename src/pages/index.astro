---
import Base from '../layouts/Base.astro';
import WorkRows from '../components/WorkRows.astro';
import Globe from '../components/Globe.astro';
import Field from '../components/Field.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const featured = works.filter((w) => w.data.featured).slice(0, 4);
---

<Base>
  <section class="hero--instrument wrap">
    <Field cols={4} />

    <div class="hero__grid">
      <div>
        <div class="hero__top" data-reveal>
          <p class="mono" data-boot>Student · Digital Media · Suzhou</p>
        </div>

        <h1 class="t-display">
          <span class="line-mask"><span style="--i:0">刘启征</span></span>
        </h1>

        <p class="hero__lede-s" data-reveal style="--d:1">
          Posters, short films and AI-driven visuals — building a pipeline from idea to
          final frame.
          <span class="cn">做海报、剪短片，也在把 AI 工具一点点拧成一条真能干活的生产管线。</span>
        </p>
      </div>

      <div class="hero__globe" data-reveal style="--d:2">
        <Globe />
      </div>
    </div>

    <div class="hero__bottom" data-reveal>
      <dl class="data-row">
        <div><dt>Local</dt><dd data-clock>--:--:--</dd></div>
        <div><dt>Zone</dt><dd>UTC+08:00</dd></div>
        <div><dt>Lat</dt><dd data-lat>31.2989° N</dd></div>
        <div><dt>Lon</dt><dd data-lon>120.5853° E</dd></div>
      </dl>
      <span class="tc">REC <span class="tc__num" data-tc>00:00:00:00</span></span>
    </div>
  </section>

  <script>
    // 地球拖到哪，读数就变到哪（视图中心经纬度）
    const fmt = (v: number, pos: string, neg: string) =>
      Math.abs(v).toFixed(4) + '° ' + (v >= 0 ? pos : neg);

    function bindGlobeReadout() {
      const lat = document.querySelector<HTMLElement>('[data-lat]');
      const lon = document.querySelector<HTMLElement>('[data-lon]');
      if (!lat || !lon) return;
      const w = window as Window & { __globeBound?: boolean };
      if (w.__globeBound) return;
      w.__globeBound = true;
      window.addEventListener('globe:view', (e: Event) => {
        const d = (e as CustomEvent<{ lat: number; lon: number }>).detail;
        lat.textContent = fmt(d.lat, 'N', 'S');
        lon.textContent = fmt(d.lon, 'E', 'W');
      });
    }

    document.addEventListener('astro:page-load', bindGlobeReadout);
    bindGlobeReadout();
  </script>

  <section class="section wrap">
    <div class="section-head">
      <p class="mono" data-reveal>Recent work <span class="cn cn--inline">最近的作品</span></p>
      <a class="link-u mono" href="/work/" data-cursor="hover">All work ({works.length})</a>
    </div>
    <WorkRows items={featured} />
  </section>

  <section class="section wrap">
    <hr class="rule" />
    <div class="split">
      <p class="mono" data-reveal>Currently <span class="cn cn--inline">现在</span></p>
      <div data-reveal style="--d:1">
        <p class="t-h2" style="margin-bottom:20px">
          Open to internships, collaborations<br />and commissioned posters.
        </p>
        <p class="cn" style="margin-bottom:22px">接实习、接合作，也接海报和短片的活。</p>
        <a class="btn btn--solid" href="/contact/" data-cursor="hover">Get in touch</a>
      </div>
    </div>
  </section>
</Base>
