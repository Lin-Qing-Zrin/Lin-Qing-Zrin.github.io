---
import Base from '../layouts/Base.astro';
import WorkRows from '../components/WorkRows.astro';
import Globe from '../components/Globe.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const featured = works.filter((w) => w.data.featured).slice(0, 4);
---

<Base>
  <section class="hero--instrument wrap">
    <div class="hero__grid">
      <div>
        <div class="hero__top" data-reveal>
          <p class="mono">Student — Digital Media — Suzhou</p>
        </div>

        <h1 class="t-display">
          <span class="line-mask"><span style="--i:0">刘启征</span></span>
        </h1>

        <p class="hero__lede-s" data-reveal style="--d:1">
          Posters, short films and AI-driven visuals. Studying Digital Media Technology —
          <em>building a pipeline from idea to final frame.</em>
        </p>
      </div>

      <div class="hero__globe" data-reveal style="--d:2">
        <Globe />
      </div>
    </div>

    <div class="hero__bottom" data-reveal>
      <dl class="data-row">
        <div><dt>Local</dt><dd data-clock>--:--:--</dd></div>
        <div><dt>Zone</dt><dd>UTC+08:00</dd></div>
        <div><dt>Lat</dt><dd>31.2989° N</dd></div>
        <div><dt>Lon</dt><dd>120.5853° E</dd></div>
      </dl>
      <span class="tc">REC <span class="tc__num" data-tc>00:00:00:00</span></span>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <p class="mono" data-reveal>Recent work</p>
      <a class="link-u mono" href="/work/" data-cursor="hover">All work ({works.length})</a>
    </div>
    <WorkRows items={featured} />
  </section>

  <section class="section wrap">
    <hr class="rule" />
    <div class="split">
      <p class="mono" data-reveal>Currently</p>
      <div data-reveal style="--d:1">
        <p class="t-h2" style="margin-bottom:20px">
          Open to internships, collaborations<br />and commissioned posters.
        </p>
        <a class="btn btn--solid" href="/contact/" data-cursor="let’s talk">Get in touch</a>
      </div>
    </div>
  </section>
</Base>
