---
import Base from '../layouts/Base.astro';
import Globe from '../components/Globe.astro';
import Field from '../components/Field.astro';
import { practice } from '../data/practice';
---

<Base>
  <section class="hero--instrument wrap">
    <Field cols={4} />

    <div class="hero__grid">
      <div>
        <div class="hero__top" data-reveal>
          <p class="mono" data-boot>Film · Game · VFX · Self-media</p>
        </div>

        <h1 class="t-display hero__name">
          <span class="line-mask"
            ><span style="--i:0" data-namefx
              ><span class="fx-ch">刘</span><span class="fx-ch">启</span><span class="fx-ch">征</span></span
            ></span
          >
        </h1>

        <p class="hero__lede-s" data-reveal style="--d:1">
          Short films, game levels and VFX — written, built and cut by one person.
          Digital Media Technology student in Suzhou.
          <span class="cn"
            >短片、游戏场景、特效 —— 一个人写、一个人搭、一个人剪。苏州，数字媒体技术专业在读。</span
          >
        </p>
      </div>

      <div class="hero__globe" data-reveal style="--d:2">
        <Globe />
      </div>
    </div>

    <div class="hero__bottom" data-reveal>
      <dl class="data-row">
        <div><dt>Local</dt><dd data-clock>--:--:--</dd></div>
        <div><dt>Zone</dt><dd>UTC+08:00</dd></div>
        <div><dt>View lat</dt><dd data-lat>31.2989° N</dd></div>
        <div><dt>View lon</dt><dd data-lon>120.5853° E</dd></div>
      </dl>
      <span class="tc">REC <span class="tc__num" data-tc>00:00:00:00</span></span>
    </div>
  </section>

  <script>
    // 地球拖到哪，读数就变到哪（视图中心经纬度）
    const fmt = (v: number, pos: string, neg: string) =>
      Math.abs(v).toFixed(4) + '° ' + (v >= 0 ? pos : neg);

    function bindGlobeReadout() {
      const lat = document.querySelector<HTMLElement>('[data-lat]');
      const lon = document.querySelector<HTMLElement>('[data-lon]');
      if (!lat || !lon) return;
      const w = window as Window & { __globeBound?: boolean };
      if (w.__globeBound) return;
      w.__globeBound = true;
      window.addEventListener('globe:view', (e: Event) => {
        const d = (e as CustomEvent<{ lat: number; lon: number }>).detail;
        const roll = (window as Window & { dsRoll?: (el: HTMLElement, v: string) => void }).dsRoll;
        const set = (el: HTMLElement, v: string) => (roll ? roll(el, v) : (el.textContent = v));
        set(lat, fmt(d.lat, 'N', 'S'));
        set(lon, fmt(d.lon, 'E', 'W'));
      });
    }

    document.addEventListener('astro:page-load', bindGlobeReadout);
    bindGlobeReadout();

    // 名字：指针离开的地方失焦，靠近的地方对焦（像镜头拉焦）
    function bindNameFocus() {
      const name = document.querySelector<HTMLElement>('[data-namefx]');
      if (!name) return;
      const w = window as Window & { __nameFx?: boolean };
      if (w.__nameFx) return;
      w.__nameFx = true;

      const chars = [...name.querySelectorAll<HTMLElement>('.fx-ch')];
      if (!chars.length) return;
      const hero = name.closest('.hero--instrument') ?? document.body;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;

      let px = -9999;
      let py = -9999;
      let inside = false;
      const cur = chars.map(() => 0);

      hero.addEventListener('pointermove', (e) => {
        px = (e as PointerEvent).clientX;
        py = (e as PointerEvent).clientY;
        inside = true;
      });
      hero.addEventListener('pointerleave', () => {
        inside = false;
      });

      const loop = () => {
        chars.forEach((el, i) => {
          const r = el.getBoundingClientRect();
          const cx = r.left + r.width / 2;
          const cy = r.top + r.height / 2;
          const d = Math.hypot(px - cx, py - cy);
          const target = inside ? Math.max(0, 1 - d / 300) : 0;
          cur[i] += (target - cur[i]) * 0.14;
          const a = cur[i];
          el.style.transform =
            a > 0.01 ? `translateY(${(-a * 7).toFixed(1)}px) scale(${(1 + a * 0.016).toFixed(3)})` : '';
          el.style.filter = a < 0.995 ? `blur(${((1 - a) * 0.9).toFixed(2)}px)` : '';
          el.style.textShadow =
            a > 0.04
              ? `${(a * 5).toFixed(1)}px 0 rgba(255, 59, 31, 0.38), ${(-a * 5).toFixed(1)}px 0 rgba(90, 255, 220, 0.24)`
              : 'none';
        });
        requestAnimationFrame(loop);
      };
      loop();
    }

    document.addEventListener('astro:page-load', bindNameFocus);
    bindNameFocus();

    /* 首屏拆解：向下滚时名字缩进左上角导航、地球缩向右下、其余淡出 */
    function bindHeroMorph() {
      const hero = document.querySelector<HTMLElement>('.hero--instrument');
      const nameEl = hero?.querySelector<HTMLElement>('.hero__name');
      const globe = hero?.querySelector<HTMLElement>('.hero__globe');
      const top = hero?.querySelector<HTMLElement>('.hero__top');
      const lede = hero?.querySelector<HTMLElement>('.hero__lede-s');
      const bottom = hero?.querySelector<HTMLElement>('.hero__bottom');
      const brand = document.querySelector<HTMLElement>('.site-header .brand');
      if (!hero || !nameEl || !globe || !brand) return;
      const W = window as Window & { __heroMorph?: boolean };
      if (W.__heroMorph) return;
      W.__heroMorph = true;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const fly = document.createElement('div');
      fly.className = 'fly-name';
      fly.textContent = '刘启征';
      fly.setAttribute('aria-hidden', 'true');
      document.body.appendChild(fly);

      let startX = 0;
      let startY = 0;
      let gdx = 0;
      let gdy = 0;
      let globeScale = 0.3;

      const measure = () => {
        fly.style.fontSize = getComputedStyle(nameEl).fontSize;
        const r = nameEl.getBoundingClientRect();
        startX = r.left;
        startY = r.top + window.scrollY;
        const g = globe.getBoundingClientRect();
        gdx = window.innerWidth - 210 - (g.left + g.width / 2);
        gdy = window.innerHeight - 210 - (g.top + g.height / 2);
        globeScale = Math.max(0.12, 190 / Math.max(1, g.width));
      };

      let cur = 0;
      let target = 0;
      let raf = 0;

      const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

      const apply = () => {
        cur += (target - cur) * 0.16;
        const p = cur;

        if (p < 0.004) {
          fly.style.opacity = '0';
          nameEl.style.opacity = '';
          brand.style.opacity = '';
        } else {
          const br = brand.getBoundingClientRect();
          const scale = Math.max(0.05, br.height / Math.max(1, fly.offsetHeight));
          const sc = 1 + (scale - 1) * p;
          const x = startX + (br.left - startX) * p;
          const startViewY = startY - window.scrollY;
          const endViewY = br.top + br.height / 2 - (fly.offsetHeight * sc) / 2;
          const y = startViewY + (endViewY - startViewY) * p;
          fly.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) scale(${sc.toFixed(4)})`;
          fly.style.opacity = String(p > 0.9 ? clamp01(1 - (p - 0.9) / 0.1) : clamp01((p - 0.07) / 0.07));

          // 只有名字离开原位；其余内容照常随页面滚走，不做集体淡出（否则中间会留一大片空场）
          nameEl.style.opacity = String(clamp01(1 - p / 0.1));
          brand.style.opacity = String(clamp01((p - 0.9) / 0.1));
        }

        if (Math.abs(target - cur) > 0.002) raf = requestAnimationFrame(apply);
        else raf = 0;
      };

      const onScroll = () => {
        const h = hero.offsetHeight || window.innerHeight;
        const next = clamp01(window.scrollY / (h * 0.42));
        if (next === target && raf) return;
        target = next;
        if (!raf) raf = requestAnimationFrame(apply);
      };

      measure();
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => {
        measure();
        onScroll();
      });
      document.addEventListener('astro:before-swap', () => {
        fly.remove();
        (window as Window & { __heroMorph?: boolean }).__heroMorph = false;
      });
    }

    document.addEventListener('astro:page-load', bindHeroMorph);
    bindHeroMorph();

    /* PRACTICE 悬停：光标右侧浮现该方向的一张代表图 */
    function bindPracticePeek() {
      const list = document.querySelector<HTMLElement>('[data-prac]');
      const peek = document.querySelector<HTMLElement>('[data-prac-peek]');
      const img = peek?.querySelector('img');
      if (!list || !peek || !img) return;
      const W = window as Window & { __pracPeek?: boolean };
      if (W.__pracPeek) return;
      W.__pracPeek = true;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (window.matchMedia('(hover: none)').matches) return;

      let tx = window.innerWidth * 0.62;
      let ty = window.innerHeight * 0.4;
      let cx = tx;
      let cy = ty;

      list.addEventListener('pointermove', (e) => {
        const ev = e as PointerEvent;
        tx = ev.clientX + 34;
        ty = ev.clientY - peek.offsetHeight * 0.5;
      });
      list.querySelectorAll<HTMLElement>('[data-peek]').forEach((a) => {
        a.addEventListener('pointerenter', () => {
          const src = a.dataset.peek;
          if (src && img.getAttribute('src') !== src) img.src = src;
          const label = peek.querySelector<HTMLElement>('[data-peek-label]');
          if (label) label.textContent = a.dataset.peekLabel ?? '';
          peek.classList.add('is-on');
        });
      });
      list.addEventListener('pointerleave', () => peek.classList.remove('is-on'));

      const loop = () => {
        cx += (tx - cx) * 0.16;
        cy += (ty - cy) * 0.16;
        peek.style.transform = `translate3d(${cx.toFixed(1)}px, ${cy.toFixed(1)}px, 0)`;
        requestAnimationFrame(loop);
      };
      loop();
    }

    document.addEventListener('astro:page-load', bindPracticePeek);
    bindPracticePeek();
  </script>

  <section class="section wrap">
    <div class="section-head">
      <p class="mono" data-reveal>Practice <span class="cn cn--inline">在做什么</span></p>
      <a class="link-u mono" href="/work/" data-cursor="hover">All categories (7)</a>
    </div>

    <ol class="prac" data-prac>
      {practice.map((e, i) => (
        <li class="prac__row" data-reveal style={`--d:${i}`}>
          <a href={e.href} data-cursor="hover" data-peek={e.img} data-peek-label={e.cn}>
            <span class="mono prac__no">{e.no}</span>
            <span class="prac__en">{e.en}</span>
            <span class="prac__cn">{e.cn}</span>
            <span class="mono prac__note">{e.note}</span>
            <span class="mono prac__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="prac-peek" data-prac-peek aria-hidden="true">
      <img alt="" />
      <span class="prac-peek__badge">View<span class="prac-peek__arrow">↗</span></span>
      <span class="prac-peek__label mono" data-peek-label></span>
    </div>
  </section>

  <section class="section wrap" style="padding-top: clamp(40px, 5vw, 76px)">
    <hr class="rule" />
    <div class="section-head">
      <p class="mono" data-reveal>Pipeline <span class="cn cn--inline">一条管线</span></p>
      <span class="mono section-head__aside" data-reveal style="--d:1">One person · five stages</span>
    </div>

    <ol class="pipe" data-reveal>
      <li class="pipe__node">
        <span class="mono pipe__k">01</span>
        <span class="pipe__t">Sketch</span>
        <span class="cn">起草：文案、分镜、构图</span>
      </li>
      <li class="pipe__node">
        <span class="mono pipe__k">02</span>
        <span class="pipe__t">Build</span>
        <span class="cn">搭建：引擎里把场景立起来</span>
      </li>
      <li class="pipe__node">
        <span class="mono pipe__k">03</span>
        <span class="pipe__t">Test</span>
        <span class="cn">测试：自己走一遍，哪里卡就回去改</span>
      </li>
      <li class="pipe__node">
        <span class="mono pipe__k">04</span>
        <span class="pipe__t">Ship</span>
        <span class="cn">发布：剪、调色，发出去</span>
      </li>
      <li class="pipe__node">
        <span class="mono pipe__k">05</span>
        <span class="pipe__t">Iterate</span>
        <span class="cn">提升：看数据、看反馈，再回来改</span>
      </li>
    </ol>

    <div class="pipe__foot" data-reveal style="--d:1">
      <p class="cn pipe__note">
        这四步之间的交接是我最想省掉的部分。现在还是一个人跑完全程，所以每一环都留着我的痕迹。
      </p>
      <a class="btn btn--solid" href="/contact/" data-cursor="hover">Say hello</a>
    </div>
  </section>

  <style>
    .hero__name .line-mask {
      overflow: visible;
    }
    .hero__name .fx-ch {
      display: inline-block;
      transform-origin: 50% 72%;
      will-change: filter, transform;
    }
    .prac {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--line);
    }
    .prac__row {
      border-bottom: 1px solid var(--line);
    }
    .prac__row a {
      display: flex;
      align-items: baseline;
      gap: clamp(12px, 1.8vw, 26px);
      padding: clamp(16px, 2.1vw, 28px) 0;
      text-decoration: none;
      color: inherit;
    }
    .prac__no {
      flex: none;
      width: 30px;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--gray);
      transition: color 0.35s var(--ease);
    }
    .prac__en {
      flex: none;
      font-family: var(--font-display);
      font-size: clamp(28px, 4.2vw, 58px);
      line-height: 1;
      letter-spacing: -0.02em;
      color: var(--ink);
      transition: transform 0.5s var(--ease), color 0.35s var(--ease);
    }
    .prac__cn {
      flex: none;
      font-size: 13px;
      letter-spacing: 0.02em;
      color: var(--gray);
      transition: color 0.35s var(--ease);
    }
    .prac__note {
      margin-left: auto;
      max-width: 38ch;
      text-align: right;
      font-size: 10px;
      letter-spacing: 0.08em;
      color: var(--gray);
      transition: color 0.35s var(--ease);
    }
    .prac__arrow {
      flex: none;
      font-size: 13px;
      color: var(--gray);
      transition: color 0.35s var(--ease), transform 0.45s var(--ease);
    }
    @media (hover: hover) {
      /* 悬停时该行标题退成灰（和参考站一样：让位给浮出的预览卡） */
      .prac__row a:hover .prac__en {
        transform: translateX(6px);
        color: var(--gray);
      }
      .prac__row a:hover .prac__no,
      .prac__row a:hover .prac__arrow {
        color: var(--accent);
      }
      .prac__row a:hover .prac__arrow {
        transform: translate(3px, -3px);
      }
      .prac__row a:hover .prac__cn,
      .prac__row a:hover .prac__note {
        color: var(--ink-2);
      }
    }
    .pipe {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: clamp(14px, 2.4vw, 40px);
    }
    .pipe__node {
      position: relative;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }
    .pipe__node::after {
      content: '→';
      position: absolute;
      top: -11px;
      right: calc(-0.5 * clamp(14px, 2.4vw, 40px) - 9px);
      font-size: 14px;
      color: var(--accent);
      background: var(--bg);
      padding: 0 4px;
    }
    .pipe__node:last-child::after {
      content: none;
    }
    .pipe__k {
      display: block;
      font-size: 9px;
      letter-spacing: 0.16em;
      color: var(--accent);
      margin-bottom: 10px;
    }
    .pipe__t {
      display: block;
      font-family: var(--font-display);
      font-size: clamp(22px, 2.6vw, 40px);
      letter-spacing: -0.02em;
      margin-bottom: 8px;
    }
    .pipe__node .cn {
      display: block;
      font-size: 12.5px;
      line-height: 1.8;
      color: var(--gray);
    }

    .pipe__foot {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 28px;
      margin-top: clamp(26px, 3.4vw, 44px);
      padding-top: clamp(18px, 2.4vw, 28px);
      border-top: 1px solid var(--line);
    }
    .pipe__note {
      max-width: 46ch;
      margin: 0;
    }

    @media (max-width: 860px) {
      .prac__row a {
        flex-wrap: wrap;
        row-gap: 6px;
      }
      .prac__note {
        order: 5;
        margin-left: 30px;
        max-width: none;
        text-align: left;
        flex-basis: 100%;
      }
      .prac__arrow {
        margin-left: auto;
      }
      .pipe {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        row-gap: clamp(20px, 4vw, 32px);
      }
      .pipe__node:nth-child(2)::after {
        content: none;
      }
      .pipe__foot {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</Base>
