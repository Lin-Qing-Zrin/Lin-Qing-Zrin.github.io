---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import Hud from '../components/Hud.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '刘启征 — 数字媒体 & AI 视觉',
  description = '苏州健雄职业技术学院 · 数字媒体技术在读。做海报、短片与 AI 视觉。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0c" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/og.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- 字体：正式上线时改成自托管 woff2，见 README -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body>
    <div class="preloader" data-preloader>
      <span class="preloader__word" data-preloader-word>Hello</span>
    </div>

    <div class="film-edge film-edge--l" aria-hidden="true"></div>
    <div class="film-edge film-edge--r" aria-hidden="true"></div>

    <div class="grain" aria-hidden="true"></div>
    <div class="veil is-on" data-veil aria-hidden="true"></div>

    <Hud />
    <Cursor />
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      import Lenis from 'lenis';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isTouch = window.matchMedia('(hover: none)').matches;

      /* ------------------------------------------------------------
         共享状态：指针位置与「本页」的 DOM 引用。
         全局监听只绑一次，页面切换只换引用，不会叠加。
         ------------------------------------------------------------ */
      const pointer = { x: window.innerWidth / 2, y: window.innerHeight / 2, moved: false };
      let cursorEl: HTMLElement | null = null;
      let previewEl: HTMLElement | null = null;

      let cx = pointer.x;
      let cy = pointer.y;
      let px = pointer.x;
      let py = pointer.y;

      // 仪器层状态（每页重新绑定）
      let fieldEl: HTMLElement | null = null;
      let fieldTimer = 0;
      let ghostEls: HTMLElement[] = [];
      let hudFrame: HTMLElement | null = null;
      let hudScroll: HTMLElement | null = null;
      let hudTarget: HTMLElement | null = null;
      let tick = 0;

      window.addEventListener(
        'pointermove',
        (e) => {
          pointer.x = e.clientX;
          pointer.y = e.clientY;
          if (!pointer.moved) {
            pointer.moved = true;
            // 鼠标真正移动过之前不显示自定义光标，避免加载瞬间出现一个孤立的点
            cx = e.clientX;
            cy = e.clientY;
            document.querySelector<HTMLElement>('.cursor')?.classList.add('is-live');
          }
        },
        { passive: true }
      );

      // 全站唯一的渲染循环
      function frame() {
        if (cursorEl) {
          cx += (pointer.x - cx) * 0.15;
          cy += (pointer.y - cy) * 0.15;
          cursorEl.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
        }
        if (previewEl) {
          px += (pointer.x - px) * 0.12;
          py += (pointer.y - py) * 0.12;
          previewEl.style.transform = `translate3d(${px + 28}px, ${py - previewEl.offsetHeight / 2}px, 0)`;
        }

        // 背景层跟着指针反向微移：8~16px 就够，多了像玩具
        if (fieldEl) {
          const fx = (0.5 - pointer.x / window.innerWidth) * 16;
          const fy = (0.5 - pointer.y / window.innerHeight) * 10;
          fieldEl.style.translate = `${fx.toFixed(1)}px ${fy.toFixed(1)}px`;
        }

        // 每 4 帧算一次幽灵字视差、每 6 帧刷一次读数
        if (ghostEls.length && tick % 4 === 0) {
          const vh = window.innerHeight;
          for (const g of ghostEls) {
            const r = g.getBoundingClientRect();
            const p = (r.top + r.height / 2 - vh / 2) / vh;
            g.style.translate = `0 ${(-p * 44).toFixed(1)}px`;
          }
        }
        if (tick % 6 === 0) updateHud();
        tick += 1;

        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);

      /* ------------------------------------------------------------
         Lenis
         ------------------------------------------------------------ */
      let lenis: Lenis | null = null;
      let lenisRaf = 0;

      function initLenis() {
        lenis?.destroy();
        cancelAnimationFrame(lenisRaf);
        lenis = null;
        if (reduceMotion) return;
        lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 0.9, smoothWheel: true });
        const loop = (time: number) => {
          lenis?.raf(time);
          lenisRaf = requestAnimationFrame(loop);
        };
        lenisRaf = requestAnimationFrame(loop);
      }

      /* ------------------------------------------------------------
         入场：滚动揭示 + 首屏遮罩
         ------------------------------------------------------------ */
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window) || reduceMotion) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      }

      function initHero() {
        requestAnimationFrame(() =>
          requestAnimationFrame(() => document.documentElement.classList.add('is-ready'))
        );
      }

      /* ------------------------------------------------------------
         页脚本地时间
         ------------------------------------------------------------ */
      function initClock() {
        const nodes = document.querySelectorAll<HTMLElement>('[data-clock]');
        if (!nodes.length) return;
        const tick = () => {
          const now = new Date();
          const time = new Intl.DateTimeFormat('en-GB', {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
            timeZone: 'Asia/Shanghai',
          }).format(now);
          const tz =
            new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Shanghai', timeZoneName: 'short' })
              .formatToParts(now)
              .find((p) => p.type === 'timeZoneName')?.value ?? '';
          nodes.forEach((n) => (n.textContent = `${time} ${tz}`));
        };
        tick();
        window.setInterval(tick, 1000 * 20);
      }

      /* ------------------------------------------------------------
         HUD：滚动帧号 / 进度 / 悬停目标
         ------------------------------------------------------------ */
      function updateHud() {
        if (!hudFrame && !hudScroll) return;
        const y = window.scrollY;
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const p = Math.min(1, Math.max(0, y / max));
        if (hudFrame) hudFrame.textContent = String(Math.round(y * 0.6)).padStart(6, '0');
        if (hudScroll) hudScroll.textContent = String(Math.round(p * 100)).padStart(3, '0');
      }

      function setHudTarget(text: string) {
        if (!hudTarget) return;
        hudTarget.textContent = text;
        hudTarget.classList.toggle('is-on', Boolean(text));
      }

      function initHud() {
        hudFrame = document.querySelector<HTMLElement>('[data-hud-frame]');
        hudScroll = document.querySelector<HTMLElement>('[data-hud-scroll]');
        hudTarget = document.querySelector<HTMLElement>('[data-hud-target]');
        updateHud();
      }

      /* ------------------------------------------------------------
         背景数据场：等宽乱码，低频扰动（不是每帧重排）
         ------------------------------------------------------------ */
      const GLYPHS = 'abcdefghijklmnopqrstuvwxyz0123456789·/.';

      function makeLine(len: number) {
        let s = '';
        for (let i = 0; i < len; i++) s += GLYPHS[(Math.random() * GLYPHS.length) | 0];
        return s;
      }

      /* ------------------------------------------------------------
         幽灵大字：按「字数」估宽降号，长词组永远不裁边
         （绝对定位元素量不出真实文字宽度，用 CJK=1em / 拉丁=0.55em 估算）
         ------------------------------------------------------------ */
      function fitGhost(el: HTMLElement, text: string) {
        el.textContent = text;
        el.style.fontSize = '';
        const avail = (el.parentElement?.clientWidth ?? window.innerWidth) * 0.92;
        let units = 0;
        for (const ch of text) {
          units += /[\u3000-\u9fff\uff00-\uffef]/.test(ch) ? 1 : 0.55;
        }
        el.style.fontSize =
          Math.max(28, Math.min(200, avail / Math.max(units, 1))).toFixed(1) + 'px';
      }

      function initField() {
        window.clearInterval(fieldTimer);
        fieldEl = document.querySelector<HTMLElement>('[data-field]');
        if (!fieldEl) return;

        const el = fieldEl;
        const cols = Number(el.dataset.cols || 4);
        const lines = 56;
        const data: string[][] = [];
        el.textContent = '';

        for (let c = 0; c < cols; c++) {
          const span = document.createElement('span');
          const col: string[] = [];
          for (let l = 0; l < lines; l++) col.push(makeLine(12 + ((Math.random() * 12) | 0)));
          span.textContent = col.join('\n');
          el.appendChild(span);
          data.push(col);
        }

        if (reduceMotion) return;

        // 每次只搅两行：看起来一直在动，但几乎没有布局开销
        fieldTimer = window.setInterval(() => {
          if (document.hidden) return;
          for (let k = 0; k < 2; k++) {
            const c = (Math.random() * cols) | 0;
            const col = data[c];
            const li = (Math.random() * col.length) | 0;
            col[li] = makeLine(12 + ((Math.random() * 12) | 0));
            (el.children[c] as HTMLElement).textContent = col.join('\n');
          }
        }, 160);
      }

      /* ------------------------------------------------------------
         幽灵大字（视差在 frame 里做，这里只管收集）
         ------------------------------------------------------------ */
      function initGhosts() {
        ghostEls = Array.from(document.querySelectorAll<HTMLElement>('[data-ghost]'));
        for (const g of ghostEls) fitGhost(g, g.textContent ?? '');
      }

      /* ------------------------------------------------------------
         切页遮罩：进场时淡出
         ------------------------------------------------------------ */
      function initVeil() {
        const veil = document.querySelector<HTMLElement>('[data-veil]');
        if (!veil) return;
        requestAnimationFrame(() =>
          requestAnimationFrame(() => veil.classList.remove('is-on'))
        );
      }

      /* ------------------------------------------------------------
         自定义光标（元素级绑定，每页重绑；循环在 frame 里）
         ------------------------------------------------------------ */
      function initCursor() {
        cursorEl = document.querySelector<HTMLElement>('.cursor');
        if (!cursorEl || isTouch || reduceMotion) {
          if (cursorEl) cursorEl.style.display = 'none';
          return;
        }
        if (!pointer.moved) {
          cx = pointer.x;
          cy = pointer.y;
        } else {
          // 页面切换后新光标元素默认隐形，鼠标已经动过就直接点亮
          cursorEl.classList.add('is-live');
        }
        const lbl = cursorEl.querySelector<HTMLElement>('[data-cursor-lbl]');
        const setLbl = (text: string) => {
          if (lbl) lbl.textContent = text;
          cursorEl?.classList.toggle('is-label', Boolean(text));
        };

        document.querySelectorAll<HTMLElement>('[data-cursor]').forEach((el) => {
          el.addEventListener('pointerenter', () => {
            const label = el.dataset.cursor;
            if (label && label !== 'hover') setLbl(label);
            else cursorEl?.classList.add('is-hover');
          });
          el.addEventListener('pointerleave', () => {
            cursorEl?.classList.remove('is-hover');
            setLbl('');
          });
        });

        // 作品行：右侧 HUD 显示目标（编号 / 类型 / 年份）；页面上的幽灵大字跟着换成该作品的类型
        const ghost = document.querySelector<HTMLElement>('[data-ghost]');
        const ghostDefault = ghost?.textContent ?? '';

        document.querySelectorAll<HTMLElement>('[data-title]').forEach((row) => {
          row.addEventListener('pointerenter', () => {
            if (row.dataset.label) setHudTarget(row.dataset.label);
            if (row.dataset.cat && ghost) fitGhost(ghost, row.dataset.cat);
          });
          row.addEventListener('pointerleave', (e) => {
            const to = e.relatedTarget;
            if (to instanceof Element && to.closest('[data-title]')) return;
            setHudTarget('');
            if (ghost) fitGhost(ghost, ghostDefault);
          });
        });
      }

      /* ------------------------------------------------------------
         作品行 → 光标跟随预览
         ------------------------------------------------------------ */
      function initPreview() {
        previewEl = document.querySelector<HTMLElement>('.preview');
        if (!previewEl || isTouch || reduceMotion) {
          previewEl = null;
          return;
        }
        const layers = Array.from(previewEl.querySelectorAll<HTMLImageElement>('.preview__img'));
        if (layers.length < 2) {
          previewEl = null;
          return;
        }
        if (!pointer.moved) {
          px = pointer.x;
          py = pointer.y;
        }

        let front = 0;
        let token = 0;

        // 两张图层交叉淡入：新图 decode 完成后才切换，避免闪一下空白
        const show = async (src: string) => {
          const back = layers[1 - front];
          if (back.classList.contains('is-front') && back.dataset.src === src) return;
          const mine = ++token;
          back.dataset.src = src;
          back.src = src;
          try {
            await back.decode();
          } catch {
            /* decode 失败也照常显示 */
          }
          if (mine !== token) return;
          back.classList.add('is-front');
          layers[front].classList.remove('is-front');
          front = 1 - front;
        };

        document.querySelectorAll<HTMLAnchorElement>('.work-row').forEach((row) => {
          const src = row.dataset.preview;
          if (!src) return;
          const ratio = row.dataset.ratio || '4:5';
          row.addEventListener('pointerenter', () => {
            previewEl?.classList.add('is-on');
            if (previewEl) previewEl.dataset.ratio = ratio;
            void show(src);
          });
          row.addEventListener('pointerleave', (e) => {
            // 在作品行之间移动时保持显示，只有真正离开列表才淡出
            const to = e.relatedTarget;
            if (to instanceof Element && to.closest('.work-row')) return;
            previewEl?.classList.remove('is-on');
          });
        });
      }

      /* ------------------------------------------------------------
         预加载：只在首次进入播放
         ------------------------------------------------------------ */
      function initPreloader() {
        const el = document.querySelector<HTMLElement>('[data-preloader]');
        if (!el) return;
        if (reduceMotion || sessionStorage.getItem('preloaded') === '1') {
          el.remove();
          return;
        }
        const word = el.querySelector<HTMLElement>('[data-preloader-word]');
        const words = ['你好', 'Hello', 'Bonjour', 'नमस्ते', 'Ciao', 'Olá', 'おい', 'Hallå', 'Hallo'];
        let i = 0;
        const timer = window.setInterval(() => {
          i = (i + 1) % words.length;
          if (word) word.textContent = words[i];
        }, 95);
        window.setTimeout(() => {
          window.clearInterval(timer);
          el.classList.add('is-done');
          sessionStorage.setItem('preloaded', '1');
          window.setTimeout(() => el.remove(), 600);
        }, 900);
      }

      /* ------------------------------------------------------------
         24fps 时间码（片边 REC 读数）
         ------------------------------------------------------------ */
      let tcRaf = 0;
      const tcStart = performance.now();
      function initTimecode() {
        cancelAnimationFrame(tcRaf);
        const nodes = document.querySelectorAll<HTMLElement>('[data-tc]');
        if (!nodes.length) return;
        const pad = (n: number) => String(n).padStart(2, '0');
        const run = () => {
          const s = (performance.now() - tcStart) / 1000;
          const frame = Math.floor((s % 1) * 24);
          const text = `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(
            Math.floor(s) % 60
          )}:${pad(frame)}`;
          nodes.forEach((n) => (n.textContent = text));
          tcRaf = requestAnimationFrame(run);
        };
        if (reduceMotion) {
          nodes.forEach((n) => (n.textContent = '00:00:00:00'));
          return;
        }
        run();
      }

      function boot() {
        initPreloader();
        initLenis();
        initHero();
        initReveal();
        initClock();
        initTimecode();
        initHud();
        initField();
        initGhosts();
        initVeil();
        initPreview();
        initCursor();
      }

      document.addEventListener('astro:page-load', boot);

      // 页面切换前先把遮罩动画复位，让新页面重新播放
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.classList.remove('is-ready');
        window.clearInterval(fieldTimer);
        fieldEl = null;
        ghostEls = [];
        setHudTarget('');
      });
    </script>
  </body>
</html>
