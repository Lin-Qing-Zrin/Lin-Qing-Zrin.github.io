---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import Hud from '../components/Hud.astro';

interface Props {
  title?: string;
  description?: string;
  /** 整屏交互页（如平铺画布）用：不渲染页头/页脚/HUD/胶片边 */
  bare?: boolean;
}

const {
  title = '刘启征 — 短片 · 游戏 · 特效',
  description = '苏州健雄职业技术学院 · 数字媒体技术。短片、虚幻引擎场景与三维特效。',
  bare = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0c" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/og.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- 字体：正式上线时改成自托管 woff2，见 README -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@900&family=Archivo+Black&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body>
    <div class="preloader" data-preloader aria-hidden="true" transition:persist="preloader">
      <span class="preloader__word mono" data-preloader-word>你好</span>
      <span class="preloader__bar"><span class="preloader__fill"></span></span>
      <span class="preloader__hint mono">CLICK TO SKIP</span>
    </div>
    <div class="grain" aria-hidden="true"></div>
      <div class="scrim" aria-hidden="true"></div>
    <div class="raw-tag mono" aria-hidden="true">RAW · UNGRADED</div>
    <div class="veil" data-veil aria-hidden="true" transition:persist="veil"></div>

    {
      !bare && (
        <>
          <div class="film-edge film-edge--l" aria-hidden="true">
            <span class="film-edge__fill" />
          </div>
          <div class="film-edge film-edge--r" aria-hidden="true">
            <span class="film-edge__fill" />
          </div>
          <div class="marks" aria-hidden="true">
            <span />
            <span />
            <span />
            <span />
          </div>
          <Hud />
          <Header />
        </>
      )
    }
    <Cursor />

    <main>
      <slot />
    </main>

    {!bare && <Footer />}

    <script>
      import Lenis from 'lenis';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isTouch = window.matchMedia('(hover: none)').matches;

      /* ------------------------------------------------------------
         共享状态：指针位置与「本页」的 DOM 引用。
         全局监听只绑一次，页面切换只换引用，不会叠加。
         ------------------------------------------------------------ */
      const pointer = { x: window.innerWidth / 2, y: window.innerHeight / 2, moved: false };
      let cursorEl: HTMLElement | null = null;
      let previewEl: HTMLElement | null = null;

      let cx = pointer.x;
      let cy = pointer.y;
      let px = pointer.x;
      let py = pointer.y;

      // 仪器层状态（每页重新绑定）
      let fieldEl: HTMLElement | null = null;
      let fieldTimer = 0;
      let ghostEls: HTMLElement[] = [];
      let hudFrame: HTMLElement | null = null;
      let hudScroll: HTMLElement | null = null;
      let hudTarget: HTMLElement | null = null;
      let tick = 0;

      window.addEventListener(
        'pointermove',
        (e) => {
          pointer.x = e.clientX;
          pointer.y = e.clientY;
          if (!pointer.moved) {
            pointer.moved = true;
            // 鼠标真正移动过之前不显示自定义光标，避免加载瞬间出现一个孤立的点
            cx = e.clientX;
            cy = e.clientY;
            document.querySelector<HTMLElement>('.cursor')?.classList.add('is-live');
          }
        },
        { passive: true }
      );

      // 全站唯一的渲染循环
      let lastScroll = window.scrollY;
      let vel = 0;

      function frame() {
        if (cursorEl) {
          cx += (pointer.x - cx) * 0.15;
          cy += (pointer.y - cy) * 0.15;
          // 光标按移动速度轻微拉伸：像一颗被甩着走的墨点
          const sp = Math.min(Math.hypot(pointer.x - cx, pointer.y - cy) / 90, 0.55);
          const ang = (Math.atan2(pointer.y - cy, pointer.x - cx) * 180) / Math.PI;
          cursorEl.style.transform =
            `translate3d(${cx}px, ${cy}px, 0) rotate(${ang.toFixed(1)}deg) ` +
            `scaleX(${(1 + sp).toFixed(3)}) scaleY(${(1 - sp * 0.4).toFixed(3)})`;
        }
        if (previewEl) {
          px += (pointer.x - px) * 0.12;
          py += (pointer.y - py) * 0.12;
          // 卡片按横向速度轻微倾斜：像手里捏着一张图
          const tilt = Math.max(-7, Math.min(7, (pointer.x - px) * 0.09));
          previewEl.style.transform =
            `translate3d(${px + 28}px, ${py - previewEl.offsetHeight / 2}px, 0) ` +
            `rotate(${tilt.toFixed(2)}deg)`;
        }

        // 背景层跟着指针反向微移：8~16px 就够，多了像玩具
        if (fieldEl) {
          const fx = (0.5 - pointer.x / window.innerWidth) * 16;
          const fy = (0.5 - pointer.y / window.innerHeight) * 10;
          fieldEl.style.translate = `${fx.toFixed(1)}px ${fy.toFixed(1)}px`;
        }

        // 每 4 帧算一次幽灵字视差、每 6 帧刷一次读数
        if (ghostEls.length && tick % 4 === 0) {
          const vh = window.innerHeight;
          for (const g of ghostEls) {
            const r = g.getBoundingClientRect();
            const p = (r.top + r.height / 2 - vh / 2) / vh;
            g.style.translate = `0 ${(-p * 44).toFixed(1)}px`;
          }
        }
        if (tick % 6 === 0) updateHud();

        // 滚动速度 → CSS 变量，让颗粒和齿孔跟着"速度"呼吸
        const sy = window.scrollY;
        const dv = Math.min(1, Math.abs(sy - lastScroll) / 90);
        vel = vel * 0.82 + dv * 0.18;
        lastScroll = sy;
        document.documentElement.style.setProperty('--vel', vel.toFixed(3));

        tick += 1;

        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);

      /* ------------------------------------------------------------
         Lenis
         ------------------------------------------------------------ */
      let lenis: Lenis | null = null;
      let lenisRaf = 0;

      function initLenis() {
        lenis?.destroy();
        cancelAnimationFrame(lenisRaf);
        lenis = null;
        if (reduceMotion) return;
        lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 0.9, smoothWheel: true });
        const loop = (time: number) => {
          lenis?.raf(time);
          lenisRaf = requestAnimationFrame(loop);
        };
        lenisRaf = requestAnimationFrame(loop);
      }

      /* ------------------------------------------------------------
         入场：滚动揭示 + 首屏遮罩
         ------------------------------------------------------------ */
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window) || reduceMotion) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      }

      function initHero() {
        requestAnimationFrame(() =>
          requestAnimationFrame(() => document.documentElement.classList.add('is-ready'))
        );
      }

      /* ------------------------------------------------------------
         里程表：只让变化的字符滚动，其它字符原地不动
         ------------------------------------------------------------ */
      function rollTo(el: HTMLElement, next: string) {
        if (el.dataset.v === next) return;
        const prev = el.dataset.v ?? '';
        el.dataset.v = next;
        if (reduceMotion) {
          el.textContent = next;
          return;
        }
        let html = '';
        for (let i = 0; i < next.length; i++) {
          const ch = next[i] === ' ' ? '&nbsp;' : next[i];
          const same = prev[i] === next[i];
          html += `<span class="odo${same ? '' : ' is-in'}">${ch}</span>`;
        }
        el.innerHTML = html;
      }
      (window as Window & { dsRoll?: typeof rollTo }).dsRoll = rollTo;

      /* ------------------------------------------------------------
         页脚本地时间
         ------------------------------------------------------------ */
      function initClock() {
        const nodes = document.querySelectorAll<HTMLElement>('[data-clock]');
        if (!nodes.length) return;
        const tick = () => {
          const now = new Date();
          const time = new Intl.DateTimeFormat('en-GB', {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
            timeZone: 'Asia/Shanghai',
          }).format(now);
          const tz =
            new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Shanghai', timeZoneName: 'short' })
              .formatToParts(now)
              .find((p) => p.type === 'timeZoneName')?.value ?? '';
          nodes.forEach((n) => rollTo(n, `${time} ${tz}`));
        };
        tick();
        window.setInterval(tick, 1000 * 20);
      }

      /* ------------------------------------------------------------
         HUD：滚动帧号 / 进度 / 悬停目标
         ------------------------------------------------------------ */
      function updateHud() {
        if (!hudFrame && !hudScroll) return;
        const y = window.scrollY;
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const p = Math.min(1, Math.max(0, y / max));
        if (hudFrame) hudFrame.textContent = String(Math.round(y * 0.6)).padStart(6, '0');
        if (hudScroll) hudScroll.textContent = String(Math.round(p * 100)).padStart(3, '0');
      }

      function setHudTarget(text: string) {
        if (!hudTarget) return;
        hudTarget.textContent = text;
        hudTarget.classList.toggle('is-on', Boolean(text));
      }

      function initHud() {
        hudFrame = document.querySelector<HTMLElement>('[data-hud-frame]');
        hudScroll = document.querySelector<HTMLElement>('[data-hud-scroll]');
        hudTarget = document.querySelector<HTMLElement>('[data-hud-target]');
        updateHud();
      }

      /* ------------------------------------------------------------
         背景数据场：等宽乱码，低频扰动（不是每帧重排）
         ------------------------------------------------------------ */
      const GLYPHS = 'abcdefghijklmnopqrstuvwxyz0123456789·/.';

      function makeLine(len: number) {
        let s = '';
        for (let i = 0; i < len; i++) s += GLYPHS[(Math.random() * GLYPHS.length) | 0];
        return s;
      }

      /* ------------------------------------------------------------
         幽灵大字：按「字数」估宽降号，长词组永远不裁边
         （绝对定位元素量不出真实文字宽度，用 CJK=1em / 拉丁=0.55em 估算）
         ------------------------------------------------------------ */
      function fitGhost(el: HTMLElement, text: string) {
        el.textContent = text;
        el.style.fontSize = '';
        const avail = (el.parentElement?.clientWidth ?? window.innerWidth) * 0.92;
        let units = 0;
        for (const ch of text) {
          units += /[\u3000-\u9fff\uff00-\uffef]/.test(ch) ? 1 : 0.55;
        }
        el.style.fontSize =
          Math.max(28, Math.min(200, avail / Math.max(units, 1))).toFixed(1) + 'px';
      }

      function initField() {
        window.clearInterval(fieldTimer);
        fieldEl = document.querySelector<HTMLElement>('[data-field]');
        if (!fieldEl) return;

        const el = fieldEl;
        const cols = Number(el.dataset.cols || 4);
        const lines = 46;
        const speeds = [30, 21, 38, 25, 44, 19, 34, 27];
        const rails: { el: HTMLElement; col: string[] }[] = [];
        el.textContent = '';

        for (let c = 0; c < cols; c++) {
          const colEl = document.createElement('span');
          colEl.className = 'field__col';
          colEl.style.setProperty('--dur', speeds[c % speeds.length] + 's');
          colEl.style.setProperty('--dir', 'normal');
          colEl.style.setProperty('--delay', (-speeds[c % speeds.length] * (0.2 + 0.18 * c)).toFixed(1) + 's');

          const railEl = document.createElement('span');
          railEl.className = 'field__rail';
          const col: string[] = [];
          for (let l = 0; l < lines; l++) col.push(makeLine(12 + ((Math.random() * 12) | 0)));
          /* 两份内容首尾相接，滚动到 -50% 时无缝接回 */
          railEl.textContent = col.join('\n') + '\n' + col.join('\n');

          colEl.appendChild(railEl);
          el.appendChild(colEl);
          rails.push({ el: railEl, col });
        }

        if (reduceMotion) return;

        /* 偶尔换掉一行：流动中带着一点「数据在刷新」的感觉 */
        fieldTimer = window.setInterval(() => {
          if (document.hidden) return;
          const target = rails[(Math.random() * rails.length) | 0];
          const li = (Math.random() * target.col.length) | 0;
          target.col[li] = makeLine(12 + ((Math.random() * 12) | 0));
          const text = target.col.join('\n');
          target.el.textContent = text + '\n' + text;
        }, 620);
      }

      /* ------------------------------------------------------------
         幽灵大字（视差在 frame 里做，这里只管收集）
         ------------------------------------------------------------ */
      function initGhosts() {
        ghostEls = Array.from(document.querySelectorAll<HTMLElement>('[data-ghost]'));
        for (const g of ghostEls) fitGhost(g, g.textContent ?? '');
      }

      /* ------------------------------------------------------------
         切页遮罩：进场时淡出
         ------------------------------------------------------------ */
      function initVeil() {
        const veil = document.querySelector<HTMLElement>('[data-veil]');
        if (!veil) return;
        veil.classList.remove('is-on', 'is-out');
      }

      /* ------------------------------------------------------------
         换页：黑场从底部升起 → 换页 → 向上抽走
         ------------------------------------------------------------ */
      function initRouteTransition() {
        const W = window as Window & { __rtBound?: boolean };
        if (W.__rtBound) return;
        W.__rtBound = true;

        document.addEventListener('astro:before-preparation', () => {
          const v = document.querySelector<HTMLElement>('[data-veil]');
          if (!v) return;
          v.classList.remove('is-out');
          v.classList.add('is-on');
        });

        document.addEventListener('astro:after-swap', () => {
          const v = document.querySelector<HTMLElement>('[data-veil]');
          if (!v) return;
          v.classList.add('is-out');
          window.setTimeout(() => v.classList.remove('is-on', 'is-out'), 560);
        });
      }

      /* ------------------------------------------------------------
         自定义光标（元素级绑定，每页重绑；循环在 frame 里）
         ------------------------------------------------------------ */
      function initCursor() {
        cursorEl = document.querySelector<HTMLElement>('.cursor');
        if (!cursorEl || isTouch || reduceMotion) {
          if (cursorEl) cursorEl.style.display = 'none';
          return;
        }
        if (!pointer.moved) {
          cx = pointer.x;
          cy = pointer.y;
        } else {
          // 页面切换后新光标元素默认隐形，鼠标已经动过就直接点亮
          cursorEl.classList.add('is-live');
        }
        const lbl = cursorEl.querySelector<HTMLElement>('[data-cursor-lbl]');
        const setLbl = (text: string) => {
          if (lbl) lbl.textContent = text;
          cursorEl?.classList.toggle('is-label', Boolean(text));
        };

        document.querySelectorAll<HTMLElement>('[data-cursor]').forEach((el) => {
          el.addEventListener('pointerenter', () => {
            const label = el.dataset.cursor;
            if (label && label !== 'hover') setLbl(label);
            else cursorEl?.classList.add('is-hover');
          });
          el.addEventListener('pointerleave', () => {
            cursorEl?.classList.remove('is-hover');
            setLbl('');
          });
        });

        // 作品行：右侧 HUD 显示目标（编号 / 类型 / 年份）；页面上的幽灵大字跟着换成该作品的类型
        const ghost = document.querySelector<HTMLElement>('[data-ghost]');
        const ghostDefault = ghost?.textContent ?? '';

        document.querySelectorAll<HTMLElement>('[data-title]').forEach((row) => {
          const title = row.querySelector<HTMLElement>('.work-row__title');
          row.addEventListener('pointerenter', () => {
            if (row.dataset.label) setHudTarget(row.dataset.label);
            const ghostText = row.dataset.ghostWord || row.dataset.cat;
            if (ghostText && ghost) fitGhost(ghost, ghostText);
          });
          // 标题跟着指针位置走：左边少、右边多，像被指针推着让路
          row.addEventListener('pointermove', (e) => {
            if (!title) return;
            const r = row.getBoundingClientRect();
            const k = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1);
            title.style.transform = `translateX(${(6 + k * 26).toFixed(1)}px)`;
          });
          row.addEventListener('pointerleave', (e) => {
            if (title) title.style.transform = '';
            const to = e.relatedTarget;
            if (to instanceof Element && to.closest('[data-title]')) return;
            setHudTarget('');
            if (ghost) fitGhost(ghost, ghostDefault);
          });
        });
      }

      /* ------------------------------------------------------------
         作品行 → 光标跟随预览
         ------------------------------------------------------------ */
      function initPreview() {
        previewEl = document.querySelector<HTMLElement>('.preview');
        if (!previewEl || isTouch || reduceMotion) {
          previewEl = null;
          return;
        }
        const layers = Array.from(previewEl.querySelectorAll<HTMLImageElement>('.preview__img'));
        if (layers.length < 2) {
          previewEl = null;
          return;
        }
        if (!pointer.moved) {
          px = pointer.x;
          py = pointer.y;
        }

        let front = 0;
        let token = 0;

        // 两张图层交叉淡入：新图 decode 完成后才切换，避免闪一下空白
        const show = async (src: string) => {
          const back = layers[1 - front];
          if (back.classList.contains('is-front') && back.dataset.src === src) return;
          const mine = ++token;
          back.dataset.src = src;
          back.src = src;
          try {
            await back.decode();
          } catch {
            /* decode 失败也照常显示 */
          }
          if (mine !== token) return;
          back.classList.add('is-front');
          layers[front].classList.remove('is-front');
          front = 1 - front;
        };

        document.querySelectorAll<HTMLAnchorElement>('.work-row').forEach((row) => {
          const src = row.dataset.preview;
          if (!src) return;
          const ratio = row.dataset.ratio || '4:5';
          row.addEventListener('pointerenter', () => {
            previewEl?.classList.add('is-on');
            if (previewEl) previewEl.dataset.ratio = ratio;
            void show(src);
          });
          row.addEventListener('pointerleave', (e) => {
            // 在作品行之间移动时保持显示，只有真正离开列表才淡出
            const to = e.relatedTarget;
            if (to instanceof Element && to.closest('.work-row')) return;
            previewEl?.classList.remove('is-on');
          });
        });
      }

      /* ------------------------------------------------------------
         预加载：已移除（访客每次刷新都看到 "Hello" 反而像加载失败）
         ------------------------------------------------------------ */
      function initPreloader() {
        const el = document.querySelector<HTMLElement>('[data-preloader]');
        if (!el) return;
        // 跨页 persist 过的那份已经播完了，别再放一遍
        if (el.classList.contains('is-done')) return;
        if (reduceMotion) {
          el.style.display = 'none';
          return;
        }

        const word = el.querySelector<HTMLElement>('[data-preloader-word]');
        const words = ['你好', 'Hello', 'Bonjour', 'नमस्ते', 'Ciao', 'Olá', 'こんにちは', 'Hallå', 'Hallo'];
        let i = 0;
        const timer = window.setInterval(() => {
          i = (i + 1) % words.length;
          if (word) word.textContent = words[i];
        }, 300);

        let closed = false;
        const close = () => {
          if (closed) return;
          closed = true;
          window.clearInterval(timer);
          window.clearTimeout(fallback);
          el.classList.add('is-done');
          window.setTimeout(() => {
            el.style.display = 'none';
          }, 520);
          window.removeEventListener('pointerdown', close);
          window.removeEventListener('keydown', close);
          window.removeEventListener('wheel', close);
        };

        const fallback = window.setTimeout(close, 1560);
        el.addEventListener('click', close);
        window.addEventListener('pointerdown', close);
        window.addEventListener('keydown', close);
        window.addEventListener('wheel', close, { passive: true });
      }

      /* ------------------------------------------------------------
         24fps 时间码（片边 REC 读数）
         ------------------------------------------------------------ */
      let tcRaf = 0;
      let tcFrozenAt = 0;
      let tcStart = performance.now();
      function initTimecode() {
        cancelAnimationFrame(tcRaf);
        const nodes = document.querySelectorAll<HTMLElement>('[data-tc]');
        if (!nodes.length) return;
        const pad = (n: number) => String(n).padStart(2, '0');
        const run = () => {
          const s = (performance.now() - tcStart) / 1000;
          const frame = Math.floor((s % 1) * 24);
          const text = `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(
            Math.floor(s) % 60
          )}:${pad(frame)}`;
          nodes.forEach((n) => (n.textContent = text));
          tcRaf = requestAnimationFrame(run);
        };
        if (reduceMotion) {
          nodes.forEach((n) => (n.textContent = '00:00:00:00'));
          return;
        }

        // 小彩蛋：点一下 REC 时间码就"定格"，再点继续走
        const tc = document.querySelector<HTMLElement>('.tc');
        if (tc && !tc.dataset.tcBound) {
          tc.dataset.tcBound = '1';
          tc.style.cursor = 'pointer';
          tc.title = 'Click to freeze';
          tc.addEventListener('click', () => {
            const frozen = tc.classList.toggle('is-frozen');
            if (frozen) {
              tcFrozenAt = performance.now() - tcStart;
              cancelAnimationFrame(tcRaf);
              (window as Window & { dsFound?: (id: string) => void }).dsFound?.('tc');
            } else {
              tcStart = performance.now() - tcFrozenAt;
              run();
            }
          });
        }

        run();
      }

      /* ------------------------------------------------------------
         磁吸：指针靠近时元素被「吸」过去几像素，离开时缓动归位
         （只在有真实指针的设备上开，触屏不做）
         ------------------------------------------------------------ */
      function initMagnetic() {
        if (reduceMotion || window.matchMedia('(hover: none)').matches) return;
        document
          .querySelectorAll<HTMLElement>('[data-magnetic], .btn, .contact-mail')
          .forEach((el) => {
            if (el.dataset.magneticBound) return;
            el.dataset.magneticBound = '1';
            el.style.transition = 'transform .5s var(--ease)';
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              const dx = (e.clientX - (r.left + r.width / 2)) / r.width;
              const dy = (e.clientY - (r.top + r.height / 2)) / r.height;
              el.style.transition = 'transform .12s linear';
              el.style.transform = `translate3d(${(dx * 12).toFixed(2)}px, ${(dy * 9).toFixed(2)}px, 0)`;
            });
            el.addEventListener('pointerleave', () => {
              el.style.transition = 'transform .6s var(--ease)';
              el.style.transform = '';
            });
          });
      }

      /* ------------------------------------------------------------
         开机：等宽小字逐帧「解码」成最终文案（只跑一次，不循环）
         ------------------------------------------------------------ */
      const SCRAMBLE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#/<>*+=';
      function bootMono() {
        document.querySelectorAll<HTMLElement>('[data-boot]').forEach((el) => {
          if (el.dataset.booted) return;
          el.dataset.booted = '1';
          const final = el.dataset.boot ?? el.textContent ?? '';
          if (!final) return;
          if (reduceMotion) {
            el.textContent = final;
            return;
          }
          let frame = 0;
          const total = 16;
          const id = window.setInterval(() => {
            frame++;
            const revealed = Math.floor((frame / total) * final.length);
            let out = '';
            for (let i = 0; i < final.length; i++) {
              const ch = final[i];
              out += i < revealed || ch === ' ' ? ch : SCRAMBLE[(Math.random() * SCRAMBLE.length) | 0];
            }
            el.textContent = out;
            if (frame >= total) {
              window.clearInterval(id);
              el.textContent = final;
            }
          }, 26);
        });
      }

      /* ------------------------------------------------------------
         胶片齿孔 = 阅读进度：读到哪儿，齿孔就「曝光」到哪儿
         ------------------------------------------------------------ */
      let edgeRaf = 0;
      function initFilmProgress() {
        const edges = Array.from(document.querySelectorAll<HTMLElement>('.film-edge'));
        if (!edges.length) return;
        const apply = () => {
          edgeRaf = 0;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
          edges.forEach((el) => el.style.setProperty('--p', (p * 100).toFixed(2) + '%'));
          document.documentElement.style.setProperty('--read', p.toFixed(4));
          /* 齿孔真的走格：每滚过一格距离，齿孔上移一格，像胶片过片 */
          const STEP = 22;
          const adv = Math.round(window.scrollY / 34) * STEP;
          document.documentElement.style.setProperty('--adv', adv + 'px');
          /* 过片的轻微晃动（gate weave），只在滚动时存在 */
          const weave = Math.round(Math.sin(window.scrollY * 0.05) * 0.7 * 10) / 10;
          document.documentElement.style.setProperty('--weave', weave.toFixed(1) + 'px');
        };
        apply();
        if ((window as Window & { __edgeBound?: boolean }).__edgeBound) return;
        (window as Window & { __edgeBound?: boolean }).__edgeBound = true;
        window.addEventListener(
          'scroll',
          () => {
            if (!edgeRaf) edgeRaf = requestAnimationFrame(apply);
          },
          { passive: true }
        );
        window.addEventListener('resize', apply);
      }

      /* ------------------------------------------------------------
         片门：指针压到图上时，图往里缩一点、四角裁切标记浮现
         （CSS 画角标，这里只负责给图打上 .gate 类）
         ------------------------------------------------------------ */
      function initGate() {
        const targets = document.querySelectorAll<HTMLElement>(
          '.take__frame, .vf-frame, .ps-tile, .id-plate, .case-cover, .gm-cover, .prac-peek__item'
        );
        targets.forEach((el) => el.classList.add('gate'));
      }

      /* ------------------------------------------------------------
         打字机：小标题逐字打出，中途打错一个再回删
         只动元素的第一个文本节点，后面的 <span class="cn"> 保持不动
         ------------------------------------------------------------ */
      const TYPO = 'abcdefghijklmnopqrstuvwxyz';
      function typeNode(node: Text, full: string, done: () => void) {
        let i = 0;
        let typoAt = Math.max(2, Math.floor(full.length * 0.55) + Math.floor(Math.random() * 3));
        if (typoAt > full.length - 2) typoAt = -1;
        node.data = '';
        const step = () => {
          if (i < full.length) {
            node.data = full.slice(0, i + 1);
            i += 1;
            if (i === typoAt) {
              const wrong = TYPO[Math.floor(Math.random() * TYPO.length)];
              node.data = full.slice(0, i) + wrong;
              window.setTimeout(() => {
                node.data = full.slice(0, i);
                window.setTimeout(step, 110);
              }, 190);
              return;
            }
            window.setTimeout(step, full[i - 1] === ' ' ? 90 : 46);
            return;
          }
          done();
        };
        window.setTimeout(step, 60);
      }

      function initTypewriter() {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-tw]'));
        if (!els.length) return;
        els.forEach((el) => {
          const first = Array.from(el.childNodes).find(
            (n): n is Text => n.nodeType === 3 && (n.textContent || '').trim().length > 0
          );
          if (!first) return;
          const full = first.textContent || '';
          if (!full.trim()) return;
          el.classList.add('tw');
          if (reduceMotion) {
            el.classList.add('is-typed');
            return;
          }
          first.data = '';
          el.classList.add('is-typing');
          let ran = false;
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting || ran) return;
                ran = true;
                io.disconnect();
                typeNode(first, full, () => {
                  el.classList.remove('is-typing');
                  el.classList.add('is-typed');
                });
              });
            },
            { threshold: 0.4 }
          );
          io.observe(el);
        });
      }

      /* ------------------------------------------------------------
         彩蛋：/secrets 的记账本
         - 找到的条目存在 localStorage（只在本地，不联网）
         - 任何地方发现彩蛋都调 window.dsFound('id')
         ------------------------------------------------------------ */
      const FOUND_KEY = 'lqz.found';
      const readFound = (): string[] => {
        try {
          const raw = localStorage.getItem(FOUND_KEY);
          return raw ? (JSON.parse(raw) as string[]) : [];
        } catch {
          return [];
        }
      };
      const writeFound = (list: string[]) => {
        try {
          localStorage.setItem(FOUND_KEY, JSON.stringify(list));
        } catch {
          /* 隐私模式下写不进去就算了 */
        }
      };
      const markFound = (id: string) => {
        const list = readFound();
        if (list.includes(id)) return;
        list.push(id);
        writeFound(list);
        document.dispatchEvent(new CustomEvent('ds:found', { detail: { id, count: list.length } }));
      };
      (window as Window & { dsFound?: typeof markFound; dsReadFound?: typeof readFound }).dsFound =
        markFound;
      (window as Window & { dsReadFound?: typeof readFound }).dsReadFound = readFound;

      /* ------------------------------------------------------------
         控制台留言：按 F12 的人才会看到
         ------------------------------------------------------------ */
      function initConsoleNote() {
        if ((window as Window & { __cNote?: boolean }).__cNote) return;
        (window as Window & { __cNote?: boolean }).__cNote = true;
        const big = 'font: 600 42px/1.1 "Noto Serif SC", serif; color:#ece9e3;';
        const small = 'font: 400 12px/1.7 ui-monospace, monospace; color:#8a8a86;';
        const acc = 'font: 500 12px/1.7 ui-monospace, monospace; color:#2b52ff;';
        console.log('%c刘启征', big);
        console.log('%cFILM · GAME · VFX · SELF-MEDIA', small);
        console.log('%c', 'font-size:0');
        console.log('%c你打开了控制台。这里通常没人来。', small);
        console.log('%c这站有五样东西不在导航里 —— 想自己找：《 /secrets 》', acc);
        console.log('%c先送你一个：在任意页面连续按下 l、q、z。', acc);
      }

      /* ------------------------------------------------------------
         彩蛋：连打 l q z → 毛片模式（全站去色，露出未调色的样子）
         再打一次或按 Esc 退出
         ------------------------------------------------------------ */
      function initRawMode() {
        let buffer = '';
        let bound = (window as Window & { __rawBound?: boolean }).__rawBound;
        if (bound) return;
        (window as Window & { __rawBound?: boolean }).__rawBound = true;

        const toggle = (on?: boolean) => {
          const root = document.documentElement;
          const next = on ?? !root.classList.contains('is-raw');
          root.classList.toggle('is-raw', next);
          if (next) markFound('raw');
        };

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            document.documentElement.classList.remove('is-raw');
            return;
          }
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          if (e.key.length !== 1) return;
          buffer = (buffer + e.key.toLowerCase()).slice(-3);
          if (buffer === 'lqz') {
            buffer = '';
            toggle();
          }
        });
      }

      /* ------------------------------------------------------------
         彩蛋：点一下页脚跑马灯 → 停住，露出一行压着的说明
         ------------------------------------------------------------ */
      function initTickerNote() {
        const footer = document.querySelector<HTMLElement>('.site-footer');
        const ticker = document.querySelector<HTMLElement>('[data-ticker]');
        if (!footer || !ticker || ticker.dataset.bound) return;
        ticker.dataset.bound = '1';

        const toggle = () => {
          const open = footer.classList.toggle('is-open');
          ticker.setAttribute('aria-pressed', String(open));
          if (open) markFound('note');
        };

        ticker.addEventListener('click', toggle);
        ticker.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggle();
          }
        });
      }

      function boot() {
        initPreloader();
        initConsoleNote();
        initRawMode();
        initTickerNote();
        initLenis();
        initHero();
        initReveal();
        initClock();
        initTimecode();
        initHud();
        initField();
        initGhosts();
        initMagnetic();
        bootMono();
        initFilmProgress();
        initVeil();
        initRouteTransition();
        initPreview();
        initCursor();
        initGate();
        initTypewriter();
      }

      document.addEventListener('astro:page-load', boot);

      // 页面切换前先把遮罩动画复位，让新页面重新播放
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.classList.remove('is-ready');
        window.clearInterval(fieldTimer);
        fieldEl = null;
        ghostEls = [];
        setHudTarget('');
      });
    </script>
  </body>
</html>
